NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# URL gốc của web (canonical/sitemap/robots). Bỏ trống thì mặc định https://app.tubutree.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tên miền gốc của link gian hàng <tên>.<gốc>; host nằm ngoài gốc này (vd *.vercel.app) không phải gian hàng. Bỏ trống thì tubutree.com.
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=
# Id Zalo OA cho nút nhắn OA; bỏ trống thì nút tắt.
NEXT_PUBLIC_ZALO_OA_ID=
# Tải ảnh thẳng lên Cloudinary (unsigned preset); bỏ trống thì ảnh nén base64.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Zalo App ID cho nút "Đăng nhập với Zalo" (dùng chung App ID với Mini App). Nhúng lúc build: build web production (Dockerfile)
# dừng nếu giá trị này rỗng; build tay `next build` không nhắc, trang đăng nhập chỉ hiện "chưa cấu hình".
NEXT_PUBLIC_ZALO_APP_ID=
