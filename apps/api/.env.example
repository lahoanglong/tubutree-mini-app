# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database / Cache ─────────────────────────────────
# Khớp docker-compose.dev.yml (Postgres 5434, Redis 6381 — song song với mini_app cũ 5433/6380)
DATABASE_URL="postgresql://tubu:tubu@localhost:5434/tubutree?schema=public"
REDIS_URL="redis://localhost:6381"

# ── JWT (đổi secret thật khi deploy) ─────────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ── Zalo Mini App / OA ───────────────────────────────
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ACCESS_TOKEN=""
