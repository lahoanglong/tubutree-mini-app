# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database / Cache ─────────────────────────────────
# Khớp docker-compose.dev.yml (Postgres 5434, Redis 6381 — song song với mini_app cũ 5433/6380)
DATABASE_URL="postgresql://tubu:tubu@localhost:5434/tubutree?schema=public"
REDIS_URL="redis://localhost:6381"

# ── JWT (đổi secret thật khi deploy) ─────────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ── Zalo Mini App / OA ───────────────────────────────
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ACCESS_TOKEN=""
ZALO_OA_REFRESH_TOKEN=""
ZALO_OA_ID=""
ZALO_OAUTH_BASE="https://oauth.zaloapp.com"
ZALO_OA_WEBHOOK_SECRET=""

# ── Pancake POS (bắt buộc ở production) ──────────────
PANCAKE_BASE_URL="https://pos.pages.fm/api/v1"
PANCAKE_API_KEY=""
PANCAKE_SHOP_ID=""
PANCAKE_WEBHOOK_SECRET="dev-pancake-webhook-secret"

# ── ZaloPay Merchant ─────────────────────────────────
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2"

# ── Accesstrade (Affiliate cashback) ─────────────────
ACCESSTRADE_BASE_URL="https://api.accesstrade.vn/v1"
ACCESSTRADE_TOKEN=""
ACCESSTRADE_PUBLISHER_ID=""
ACCESSTRADE_WEBHOOK_SECRET="dev-accesstrade-webhook-secret"

# ── CORS allowlist (CSV, bắt buộc ở production) ──────
CORS_ORIGINS="https://tubutree.com,https://app.tubutree.com,https://admin.tubutree.com"

# Cookie chứa refresh token của web shop (HttpOnly — thay cho localStorage).
# 'lax' đúng khi web và API cùng site (tubutree.com + api.tubutree.com).
# Đổi thành 'none' NẾU API nằm ở domain khác hẳn — khi đó code tự bật Secure.
AUTH_COOKIE_SAMESITE="lax"
# Bỏ trống nếu cùng host. Đặt ".tubutree.com" để mọi subdomain dùng chung phiên.
AUTH_COOKIE_DOMAIN=""

# ── AI tư vấn 24/7 (§6.14.3) — để trống thì tính năng tự tắt graceful ──
# CẢ HAI provider gọi qua endpoint OpenAI-compatible (/chat/completions, Bearer key sk-...).
# DeepSeek là provider chính; Gemini (qua proxy OpenAI-compatible, base có /v1) là dự phòng.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://gemini-api.thailam.io.vn/v1"
GEMINI_MODEL="gemini-3.5-flash"

