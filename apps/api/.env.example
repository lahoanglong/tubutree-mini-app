# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database / Cache ─────────────────────────────────
# Khớp docker-compose.dev.yml (Postgres 5434, Redis 6381 — song song với mini_app cũ 5433/6380)
DATABASE_URL="postgresql://tubu:tubu@localhost:5434/tubutree?schema=public"
REDIS_URL="redis://localhost:6381"

# ── JWT (đổi secret thật khi deploy) ─────────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me-please"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
# Giây token vừa xoay còn dùng lại được (nhiều tab refresh cùng lúc); 0 = tắt
JWT_REFRESH_REUSE_GRACE_SECONDS=30

# ── Zalo Mini App / OA ───────────────────────────────
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ACCESS_TOKEN=""
ZALO_OA_REFRESH_TOKEN=""
ZALO_OA_ID=""
ZALO_OAUTH_BASE="https://oauth.zaloapp.com"
ZALO_OA_WEBHOOK_SECRET=""

# ── Pancake POS (bắt buộc ở production) ──────────────
PANCAKE_BASE_URL="https://pos.pages.fm/api/v1"
PANCAKE_API_KEY=""
PANCAKE_SHOP_ID=""
PANCAKE_WEBHOOK_SECRET="dev-pancake-webhook-secret"

# ── Báo động sức khoẻ vận hành (ngoài thông báo in-app cho admin; bỏ trống = chỉ in-app). Slack/Google Chat/n8n, định dạng: docs/GO-LIVE-KEYS.md mục 8 ──
OPS_ALERT_WEBHOOK_URL=
# Email báo động (kênh thứ hai, gửi đúng các lần webhook trên gửi; bỏ trống CẢ BẢY biến = tắt). Đã đặt một biến thì phải
# đủ OPS_ALERT_EMAIL_TO + SMTP_HOST + (SMTP_FROM hoặc SMTP_USER là địa chỉ email), SMTP_USER và SMTP_PASS đi cặp — dở dang
# thì API không khởi động. Mật khẩu KHÔNG commit; nên là mật khẩu ứng dụng, không chứa $ hoặc dấu nháy. Chi tiết: docs/GO-LIVE-KEYS.md mục 8.
# Người nhận cách nhau bằng dấu phẩy hoặc chấm phẩy. SMTP_PORT rỗng = 587 (465 khi SMTP_SECURE=true); SMTP_SECURE=true là TLS ngay từ đầu.
OPS_ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# alerts@tubutree.com hoặc Tubu Tree <alerts@tubutree.com>
SMTP_FROM=
# Nhãn môi trường ở đầu tiêu đề email, vd "staging" → "[Tubu Tree · staging] ...". Rỗng = NODE_ENV.
OPS_ALERT_ENV_LABEL=

# ── Gomdon (vận đơn đổi hàng — thu gom vật liệu tái chế, optional) ──
# Trống ở dev = TẮT (không bao giờ tự đặt bưu tá thật từ máy dev). Gomdon KHÔNG có sandbox (tài liệu):
# đặt https://admin.gomdon.com.vn là tạo vận đơn THẬT. Xem docs/integrations/gomdon.md.
GOMDON_BASE_URL=""
GOMDON_PHONE=""
GOMDON_PASSWORD=""
# Token verify webhook Gomdon. Webhook do quản trị Gomdon cấu hình, tài liệu không nói có cho đặt header:
# header x-webhook-token nếu Gomdon cho, không thì URL /api/webhooks/gomdon/<secret>.
# Trống ở dev = nhận mọi request (có cảnh báo); production trống = từ chối mọi webhook.
GOMDON_WEBHOOK_SECRET=""

# ── ZaloPay Merchant ─────────────────────────────────
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2"

# ── Accesstrade (Affiliate cashback) ─────────────────
ACCESSTRADE_BASE_URL="https://api.accesstrade.vn/v1"
ACCESSTRADE_TOKEN=""
ACCESSTRADE_PUBLISHER_ID=""
ACCESSTRADE_WEBHOOK_SECRET="dev-accesstrade-webhook-secret"

# ── CORS allowlist (CSV, bắt buộc ở production) ──────
CORS_ORIGINS="https://tubutree.com,https://app.tubutree.com,https://admin.tubutree.com"

# Cookie chứa refresh token của web shop (HttpOnly — thay cho localStorage).
# 'lax' đúng khi web và API cùng site (tubutree.com + api.tubutree.com).
# Đổi thành 'none' NẾU API nằm ở domain khác hẳn — khi đó code tự bật Secure.
AUTH_COOKIE_SAMESITE="lax"
# Bỏ trống nếu cùng host. Đặt ".tubutree.com" để mọi subdomain dùng chung phiên.
AUTH_COOKIE_DOMAIN=""

# ── Throttle: miễn giới hạn tốc độ cho request SSR của web (header x-throttle-bypass) ──
# Mọi SSR đi ra từ cùng một IP máy chủ web nên sẽ bị 429 nếu không miễn. Web và API phải dùng
# CÙNG giá trị. Rỗng = tắt đường miễn. Đặt thì tối thiểu 32 ký tự (openssl rand -hex 32).
THROTTLE_BYPASS_TOKEN=""

# ── AI tư vấn 24/7 (§6.14.3) — để trống thì tính năng tự tắt graceful ──
# CẢ HAI provider gọi qua endpoint OpenAI-compatible (/chat/completions, Bearer key sk-...).
# DeepSeek là provider chính; Gemini (qua proxy OpenAI-compatible, base có /v1) là dự phòng.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://gemini-api.thailam.io.vn/v1"
GEMINI_MODEL="gemini-3.5-flash"

# ── AI tư vấn qua Antigravity gateway (cùng VPS với ChoDeli; xem runbook mục AI) ──
# Cần ĐỦ cả URL và KEY mới dùng; có thì được ưu tiên hơn DeepSeek/Gemini. KEY do chủ gateway cấp riêng cho Tubu Tree.
ANTIGRAVITY_GATEWAY_URL=""
ANTIGRAVITY_GATEWAY_KEY=""
ANTIGRAVITY_MODEL="gemini-3.8-flash-high"
ANTIGRAVITY_GATEWAY_TIMEOUT_MS="45000"
# antigravity | deepseek | gemini; để trống = tự chọn theo provider đã cấu hình. Đặt rõ thì không rơi sang provider khác.
AI_ADVISOR_PROVIDER=""
# Tắt khẩn cấp: đặt false rồi tạo lại container api; Mini App tự ẩn lối vào AI.
AI_ADVISOR_ENABLED="true"
AI_ADVISOR_GLOBAL_PER_MIN="40"
AI_ADVISOR_MAX_CONCURRENT="3"

