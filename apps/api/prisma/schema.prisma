  activatedAt         DateTime?
  lastConfirmedAt     DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               WastePointItem[]
  staff               WastePointStaff[]
  usage               WastePointUsage[]
  requests            WasteRequest[]

  @@index([kind, status])
  @@index([provinceCode, status])
  @@map("waste_points")
}

model WastePointItem {
  pointId String
  itemId  String
  point   WastePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  item    WasteItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([pointId, itemId])
  @@index([itemId])
  @@map("waste_point_items")
}

// CHECK and partial unique indexes: migration 20261020000000_waste_exchange, section WASTE HAND-WRITTEN CONSTRAINTS
