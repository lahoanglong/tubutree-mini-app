model Subscription {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variationId   String
  variation     Variation     @relation(fields: [variationId], references: [id], onDelete: Cascade)
  quantity      Int           @default(1)
  intervalWeeks Int // 4 / 6 / 8 / 10
  addressId     String
  // RESTRICT (C-014): xoá địa chỉ không được kéo theo xoá cứng gói định kỳ; users.deleteAddress báo lỗi rõ.
  address       Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)
  status        String        @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED
  // Chỉ COD | WALLET | BANK_TRANSFER (Q-13); WALLET trừ ví ngay lúc sinh đơn kỳ, thiếu số dư thì gói tạm dừng.
  paymentMethod PaymentMethod @default(COD)
  nextRunAt     DateTime
  // Số lần cron đã thử lại kỳ hiện tại vì hết hàng/lỗi tạm thời (reset về 0 khi ra đơn hoặc khi bỏ kỳ).
  retryCount    Int           @default(0)
  lastOrderId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, nextRunAt])
  @@index([userId])
  // Partial unique (userId, variationId, addressId) WHERE status IN ('ACTIVE','PAUSED') chỉ có trong
  // migration 20261010030000_subscription_open_unique (C-057): Prisma không biểu diễn được, đừng `db push`.
  @@map("subscriptions")
}

