// Tubu Tree — Prisma schema v0 (Phase 0)
// Nguồn: TUBU_TREE_BUILD_SPEC_v1.1.md Section 4 (Data Model) + Section 15 (SystemConfig).
// Quy ước: tên bảng số nhiều tiếng Anh, cờ pancakeId để map về Pancake POS.
// Tiền tệ (VND) dùng Int (đủ cho giá trị VND thực tế); % dùng Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 4.1 User & quyền
// ============================================================

enum UserRole {
  CUSTOMER
  AFFILIATE
  DEALER
  STAFF
  ADMIN
}

enum RoleGrantRole {
  STAFF
  ADMIN
}

/// Cấp quyền theo SĐT — áp cả khi user CHƯA mở app. Khi login/refresh, auth áp grant
/// cao nhất còn hiệu lực nếu cao hơn role hiện tại. Chỉ quản STAFF/ADMIN (CTV/đại lý đi DealerApplication).
model RoleGrant {
  id        String        @id @default(cuid())
  phone     String
  role      RoleGrantRole
  grantedBy String // adminId, hoặc "seed" cho admin gán sẵn ban đầu
  note      String?
  revokedAt DateTime? // null = còn hiệu lực
  createdAt DateTime      @default(now())

  // Chống race ở RbacService.addGrant() (findFirst rồi create, 2 request cấp quyền đồng thời cho
  // CÙNG SĐT+role có thể tạo 2 grant active trùng): partial unique index
  // "role_grants_active_phone_role_key" ON (phone, role) WHERE "revokedAt" IS NULL — Prisma schema
  // KHÔNG hỗ trợ cú pháp @@unique có điều kiện WHERE nên index này được thêm bằng migration SQL
  // thủ công (xem migrations/*_role_grant_active_unique), không khai báo được @@unique chuẩn ở đây.
  @@index([phone, revokedAt])
  @@map("role_grants")
}

enum ShiftStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Ca chuẩn admin định nghĩa (phút trong ngày để render lưới nhanh, không lệch TZ).
model ShiftTemplate {
  id        String   @id @default(cuid())
  name      String
  startMin  Int // phút từ 00:00, 480 = 08:00
  endMin    Int // 720 = 12:00
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("shift_templates")
}

/// Ca làm nhân viên đăng ký → admin duyệt (chỉnh giờ được). Cửa sổ hiệu lực = approved* ?? start/end.
model Shift {
  id            String      @id @default(cuid())
  staffId       String
  staff         User        @relation("StaffShifts", fields: [staffId], references: [id], onDelete: Cascade)
  workDate      DateTime    @db.Date
  startAt       DateTime
  endAt         DateTime
  templateId    String?
  status        ShiftStatus @default(PENDING)
  approvedStart DateTime?
  approvedEnd   DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  rejectReason  String?
  cancelReason  String?
  cancelledAt   DateTime?
  isEmergency   Boolean     @default(false)
  evidenceUrl   String?
  cancelPenalty Boolean     @default(false) // Phase D quy ra tiền (1h công)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions AttendanceSession[]

  @@index([staffId, workDate])
  @@index([workDate, status])
  @@map("shifts")
}

enum SessionCloseReason {
  MANUAL // NV bấm checkout
  OUT_OF_RANGE // heartbeat phát hiện rớt IP/GPS
  STALE // cron: heartbeat cũ quá ngưỡng
  SHIFT_END // cron chốt cuối ca
  ADMIN // admin chỉnh tay
}

/// Phiên chấm công trong 1 ca. 1 ca có nhiều phiên (nghỉ giữa ca → checkout rồi checkin lại).
model AttendanceSession {
  id              String              @id @default(cuid())
  shiftId         String
  shift           Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staffId         String
  checkinAt       DateTime            @default(now())
  checkoutAt      DateTime? // null = đang mở
  checkinLat      Float
  checkinLng      Float
  checkinIp       String
  lastHeartbeatAt DateTime            @default(now())
  outOfRangeCount Int                 @default(0) // số heartbeat ngoài vùng LIÊN TIẾP; heartbeat hợp lệ reset về 0 (C-056)
  outOfRangeSince DateTime? // nhịp ngoài vùng đầu tiên của chuỗi hiện tại; null = đang trong vùng
  closeReason     SessionCloseReason?
  isLate          Boolean             @default(false) // phiên đầu ca & trễ > grace (Phase D quy tiền)
  createdAt       DateTime            @default(now())

  @@index([shiftId])
  @@index([staffId, checkoutAt])
  @@map("attendance_sessions")
}

enum PayrollMonthStatus {
  OPEN
  FINALIZED
  PAID
}

enum AdjustmentType {
  LATE // đi trễ > grace → phạt cố định
  LATE_CANCEL // huỷ ca < 3 ngày → phạt 1h công
  MANUAL // admin cộng/trừ tay
}

/// Hồ sơ nhân viên: đơn giá giờ (theo từng người) + bank nhận lương.
model StaffProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hourlyRate      Int      @default(0) // VND/giờ
  bankBin         String? // mã Napas BIN (dựng VietQR)
  bankAccountNo   String?
  bankAccountName String?
  qrImageUrl      String? // QR tĩnh NV tự tải (ưu tiên nếu có)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("staff_profiles")
}

model PayrollAdjustment {
  id        String         @id @default(cuid())
  staffId   String
  workDate  DateTime       @db.Date
  type      AdjustmentType
  amount    Int // dương = trừ; MANUAL âm = thưởng/cộng
  reason    String
  shiftId   String?
  createdBy String?
  createdAt DateTime       @default(now())

  @@unique([shiftId, type])
  @@index([staffId, workDate])
  @@map("payroll_adjustments")
}

model PayrollDay {
  id            String    @id @default(cuid())
  staffId       String
  workDate      DateTime  @db.Date
  workedMinutes Int       @default(0)
  hourlyRate    Int       @default(0) // snapshot
  gross         Int       @default(0)
  fines         Int       @default(0)
  net           Int       @default(0)
  finalizedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([staffId, workDate])
  @@map("payroll_days")
}

model PayrollMonth {
  id            String             @id @default(cuid())
  staffId       String
  year          Int
  month         Int // 1..12
  totalMinutes  Int                @default(0)
  gross         Int                @default(0)
  totalFines    Int                @default(0)
  net           Int                @default(0)
  status        PayrollMonthStatus @default(OPEN)
  finalizedAt   DateTime?
  paidAt        DateTime?
  paidBy        String?
  proofImageUrl String? // ảnh xác nhận đã chuyển
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([staffId, year, month])
  @@map("payroll_months")
}

model User {
  id                     String          @id @default(cuid())
  zaloId                 String?         @unique // openId từ Zalo
  /// @deprecated Không nơi nào ghi giá trị; chỉ account-deletion.service gán null (C-108).
  zaloAccessToken        String? // mã hóa
  /// @deprecated Không nơi nào ghi giá trị; chỉ account-deletion.service gán null (C-108).
  zaloRefreshToken       String? // mã hóa
  phone                  String?         @unique
  /// Lần gần nhất Zalo trả đúng số này (getPhoneNumber). Điểm đơn chat chỉ tự liên kết khi mốc còn mới (loyalty.chat_phone_verified_max_days).
  phoneVerifiedAt        DateTime?
  email                  String?
  fullName               String?
  /// Tên đã gấp dấu (vn_search_fold), trigger users_full_name_search_sync giữ đồng bộ với fullName — admin tìm tên không dấu.
  fullNameSearch         String          @default("")
  /// Mã số thuế cá nhân (10 số) hoặc số CCCD 12 số dùng làm MST, CTV khai khi lần chuyển hoa hồng vào Ví đầu tiên bị khấu trừ thuế TNCN.
  personalTaxId          String?
  dob                    DateTime?
  avatarUrl              String?
  role                   UserRole        @default(CUSTOMER)
  /// Nhóm việc của STAFF ngoài quầy/chấm công (common/staff-permissions.ts): CSKH, KHO. Chỉ có tác dụng khi role = STAFF.
  staffPermissions       String[]        @default([])
  tierId                 String?
  tier                   MembershipTier? @relation(fields: [tierId], references: [id])
  tierGraceUntil         DateTime? // §6.6: thời hạn ân hạn trước khi rớt hạng (null = không treo rớt)
  referralCode           String          @unique
  referredById           String?
  /// Dòng khách đã gộp → tài khoản đích (auth.service mergeGuestInto). Mã giới thiệu cũ của khách quy về người đích
  /// (resolveMergedUserId). Không khoá ngoại: chỉ tra theo id, không cần khoá dòng đích khi ghi.
  mergedIntoId           String?
  // Điểm Xanh lô STANDARD (có hạn, trần loyalty.max_redeem_pct). == SUM(points_transactions.delta) lot STANDARD.
  pointsBalance          Int             @default(0)
  // PD-3 (Q-03a): Điểm Xanh lô CONVERTED, quy từ xu (tiền trả trước): không hết hạn, không trần, không
  // ra tiền. Cột riêng để mọi guard `gte pointsBalance` cũ (vòng quay, đổi voucher...) không chạm tới.
  // == SUM(delta) lot CONVERTED; CHECK users_points_converted_nonneg (>= 0) chỉ có trong migration SQL.
  pointsConvertedBalance Int             @default(0)
  walletBalance          Int             @default(0)
  coinsBalance           Int             @default(0) // TubuXu — tiền tệ tiêu trong app (không phải tiền VND thật)
  cashbackPending        Int             @default(0)
  isBlocked              Boolean         @default(false)
  // Khoá do admin (POST /admin/users/:id/block): ai khoá, lúc nào, vì sao. Xoá tài khoản (ẩn danh) chỉ đặt isBlocked.
  blockedAt              DateTime?
  blockedReason          String?
  blockedById            String?
  // Mốc thu hồi toàn bộ phiên (khoá tài khoản, phát hiện refresh token bị dùng lại): token xoay trước mốc này
  // không còn được hưởng khoảng ân hạn refresh đồng thời.
  sessionsRevokedAt      DateTime?
  // Đồng ý nhận tin khuyến mãi / nhắc Vườn Xanh: NotificationsService.notify bỏ qua tin thuộc nhóm đã tắt.
  notifyPromo            Boolean         @default(true)
  notifyGarden           Boolean         @default(true)
  /// @deprecated Không nơi nào ghi hoặc đọc (C-108).
  pancakeCustomerId      String?         @unique
  metadata               Json?
  /// Nguồn chạm đầu (shopee, card-<đợt>, oa, ...): ghi MỘT lần lúc tạo tài khoản, hoặc lúc gộp khách vào tài khoản còn trống; không bao giờ ghi đè (common/attribution.ts). null = chưa biết (tài khoản có trước tính năng).
  firstTouchSource       String?
  firstTouchCampaign     String?
  firstTouchAt           DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Quan hệ ngược
  addresses              Address[]
  cart                   Cart?
  orders                 Order[]
  pointsTransactions     PointsTransaction[]
  coinTransactions       CoinTransaction[]
  xuPointsConversion     XuPointsConversion?
  walletTransactions     WalletTransaction[]
  affiliateLinks         AffiliateLink[]
  commissions            Commission[]
  ctvMilestoneClaims     CtvMilestoneClaim[]
  storefronts            Storefront[]
  payouts                Payout[]
  cashbackClicks         CashbackClick[]
  cashbackTxns           CashbackTransaction[]
  dealerApplications     DealerApplication[]
  dealerTemplates        DealerOrderTemplate[]
  gameProfile            GameProfile?
  reviews                Review[]
  refreshTokens          RefreshToken[]
  plantedTrees           PlantedTree[]
  communityContributions CommunityContribution[]
  species                UserSpecies[]
  giftsSent              WaterGift[]             @relation("GiftsSent")
  giftsReceived          WaterGift[]             @relation("GiftsReceived")
  gardenPlots            GardenPlot[]
  feedPosts              FeedPost[]
  feedReactions          FeedReaction[]
  feedComments           FeedComment[]
  groupBuysStarted       GroupBuy[]              @relation("GroupBuysStarted")
  groupBuyMemberships    GroupBuyMember[]
  bottleReturns          BottleReturn[]
  wasteRequests          WasteRequest[]
  wasteGiftRedemptions   WasteGiftRedemption[]
  supportConversation    SupportConversation?
  wastePointStaff        WastePointStaff[]
  wasteFlags             WasteUserFlags?
  betaTester             BetaTester?
  betaFeedbacks          BetaFeedback[]
  subscriptions          Subscription[]
  staffShifts            Shift[]                 @relation("StaffShifts")
  staffProfile           StaffProfile?
  communityReports       CommunityReport[]       @relation("CommunityReports")
  communityProfile       CommunityProfile?       @relation("CommunityProfile")
  reputationEvents       ReputationEvent[]       @relation("ReputationEvents")
  loyaltyCheckIns        LoyaltyCheckIn[]
  posCreditsReceived     PosPointCredit[]        @relation("PosCreditMember")
  posCreditsGiven        PosPointCredit[]        @relation("PosCreditStaff")

  @@index([referredById])
  /// Báo cáo nguồn khách × tuần (admin): khách tạo trong khoảng ngày.
  @@index([createdAt])
  // Tìm đơn admin theo SĐT/tên khách (LIKE/ILIKE '%x%') — trigram GIN, cần extension pg_trgm.
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_phone_trgm_idx")
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_fullName_trgm_idx")
  @@index([fullNameSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_fullNameSearch_trgm_idx")
  @@map("users")
}

/// Sổ việc admin làm trên một tài khoản (đổi vai trò, nhóm việc nhân viên, khoá/mở khoá) — màn chi tiết người dùng đọc lại.
model UserAdminEvent {
  id        String   @id @default(cuid())
  userId    String
  /// ROLE | STAFF_PERMISSIONS | BLOCK | UNBLOCK
  kind      String
  fromValue String?
  toValue   String?
  reason    String?
  /// adminId, hoặc null khi hệ thống tự làm (áp quyền cấp sẵn theo SĐT lúc đăng nhập).
  actorId   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("user_admin_events")
}

// Refresh token lưu hash (rotation). Phục vụ Zalo auth flow Phase 0.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  // Thu hồi vì đã xoay sang token mới (khác logout/khoá). Chỉ token xoay mới được dùng lại trong khoảng ân hạn.
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  // Thống kê DAU theo ngày tạo token (analytics-aggregation.service.ts).
  @@index([createdAt])
  @@map("refresh_tokens")
}

model MembershipTier {
  id                    String  @id
  name                  String
  minPoints             Int
  minSpending           Int?
  discountPct           Decimal @default(0)
  pointMultiplier       Decimal @default(1)
  /// Mức voucher sinh nhật riêng của hạng (VNĐ) — null = dùng `voucher.birthday_amount` chung
  /// (P0 A3-05: seed hứa Lộc Biếc 50k/Đại Thụ 150k/Cổ Thụ 300k nhưng cron trước đây cấp 1 mức
  /// cho mọi hạng, xem vouchers.service.ts birthdayVouchers()).
  birthdayVoucherAmount Int?
  perks                 Json
  /// @deprecated Không nơi nào ghi hoặc đọc (C-108).
  badgeImageUrl         String?
  sortOrder             Int     @default(0)
  users                 User[]

  @@map("membership_tiers")
}

model Address {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient     String
  phone         String
  province      String
  district      String
  ward          String
  street        String
  isDefault     Boolean        @default(false)
  provinceCode  String
  districtCode  String
  wardCode      String
  subscriptions Subscription[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// 4.2 Catalog (mirror từ Pancake)
// ============================================================

model Product {
  id               String                @id @default(cuid())
  /// NULL = không có trên Pancake (sản phẩm đối tác tự giao). Không bao giờ ghi mã giả.
  pancakeId        String?               @unique
  /// TUBU = kho Tubu giao qua Pancake (gồm hàng đối tác "Tubu giao hộ"); MERCHANT = đối tác tự giao.
  fulfilment       FulfilmentMode        @default(TUBU)
  /// Mã biến thể Pancake đối tác xin liên kết khi tích "Tubu giao hộ" — admin duyệt thì biến thể đó chuyển sang sản phẩm này.
  pancakeLinkCode  String?
  brand            String
  brandId          String?
  brandRef         Brand?                @relation(fields: [brandId], references: [id])
  affiliateBlocked Boolean               @default(false)
  slug             String                @unique
  name             String
  // Tên đã gấp dấu (= foldVietnamese(name)) cho tìm không dấu có index — trigger DB
  // products_name_search_sync tự ghi khi INSERT/UPDATE name; code KHÔNG tự ghi cột này.
  nameSearch       String                @default("")
  description      String                @db.Text
  shortDesc        String?
  images           String[]
  thumbnail        String?
  categoryIds      String[]
  tags             String[]
  isActive         Boolean               @default(true)
  /// REMOVED = đồng bộ Pancake tự tắt vì sản phẩm không còn trên Pancake (xem Variation.pancakeHold).
  pancakeHold      String?
  isFeatured       Boolean               @default(false)
  isCombo          Boolean               @default(false)
  ratingAvg        Float                 @default(0) // denormalized từ reviews (cập nhật khi tạo review)
  reviewCount      Int                   @default(0)
  soldExternal     Int                   @default(0) // admin nhập — tổng đã bán gom từ các sàn TMĐT ngoài
  soldApp          Int                   @default(0) // system — đơn DELIVERED trong app (cron recompute). Hiển thị = soldExternal + soldApp
  basePrice        Int
  salePrice        Int?
  metaTitle        String?
  metaDesc         String?
  forSegment       String[]
  ingredients      Json?
  certifications   String[]
  variations       Variation[]
  reviews          Review[]
  groupBuys        GroupBuy[]
  storefrontItems  StorefrontItem[]
  storefrontId     String?
  storefront       Storefront?           @relation("StorefrontProducts", fields: [storefrontId], references: [id])
  approvalStatus   ProductApprovalStatus @default(APPROVED)
  rejectReason     String?
  communityTags    PostProductTag[]
  contentKit       ProductContentKit?
  pancakeLinks     MerchantPancakeLink[] @relation("PancakeLinkProduct")
  pancakeLinkedOut MerchantPancakeLink[] @relation("PancakeLinkOrigin")
  /// Bản sửa nội dung đang chờ duyệt của sản phẩm đang bán (R3-MERCHANT-4); sản phẩm vẫn bán với nội dung của chính dòng này.
  editDraft        ProductEditDraft?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([brand])
  @@index([brandId])
  @@index([storefrontId])
  @@index([approvalStatus])
  @@index([isActive, isFeatured])
  // GIN cho 3 cột mảng lọc bằng 'has' trong catalog.service.ts list(). PHẢI khai báo trong
  // schema (không chỉ raw SQL) để `prisma migrate` KHÔNG coi chúng là drift rồi tự sinh
  // migration DROP — đúng lỗi migration 20260628035408 đã vô tình xoá 3 index này.
  @@index([categoryIds], type: Gin, map: "products_categoryIds_gin")
  @@index([forSegment], type: Gin, map: "products_forSegment_gin")
  @@index([tags], type: Gin, map: "products_tags_gin")
  // Tìm không dấu (catalog textMatchSql: "nameSearch" LIKE '%x%') — trigram GIN, cần pg_trgm.
  @@index([nameSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_nameSearch_trgm_idx")
  @@map("products")
}

model Brand {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String           @unique
  logoUrl        String?
  coverUrl       String?
  tagline        String?
  story          String?          @db.Text
  storyImages    String[]
  origin         String?
  certifications Json?
  isVerified     Boolean          @default(false)
  isPublished    Boolean          @default(false)
  ownerUserId    String?
  followerCount  Int              @default(0)
  products       Product[]
  storefront     Storefront?
  promotions     BrandPromotion[]
  dealerRewards  DealerReward[]
  follows        BrandFollow[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Index như Storefront.ownerUserId — tra nhãn theo chủ sở hữu (assertOwnedBrand) không seq-scan.
  @@index([ownerUserId])
  @@map("brands")
}

model BrandFollow {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, brandId])
  @@index([brandId])
  @@map("brand_follows")
}

model BrandPromotion {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title      String
  subtitle   String?
  themeColor String?
  couponCode String?
  startAt    DateTime
  endAt      DateTime
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([brandId, isActive])
  @@map("brand_promotions")
}

enum DealerRewardType {
  TOUR
  GIFT
  OTHER
}

model DealerReward {
  id          String              @id @default(cuid())
  brandId     String?
  brand       Brand?              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type        DealerRewardType
  title       String
  description String?
  threshold   BigInt
  period      String              @default("QUARTER")
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  claims      DealerRewardClaim[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([brandId, isActive])
  @@map("dealer_rewards")
}

/// Vòng đời yêu cầu nhận thưởng mốc đại lý: PENDING → APPROVED | REJECTED; APPROVED → PAID.
enum DealerRewardClaimStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

/// Yêu cầu nhận thưởng mốc DealerReward (tour/quà) của 1 đại lý cho 1 kỳ (quý/năm, giờ VN).
/// Unique (userId, periodKey, rewardId) → bấm lại / 2 request đồng thời chỉ tạo đúng 1 yêu cầu.
/// Snapshot tiêu đề/loại/ngưỡng lúc yêu cầu — admin sửa hoặc xoá DealerReward sau đó không làm
/// mất dấu nghĩa vụ trao thưởng (xoá reward → rewardId SET NULL, claim vẫn còn).
model DealerRewardClaim {
  id              String                  @id @default(cuid())
  userId          String // đại lý
  rewardId        String?
  reward          DealerReward?           @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  periodKey       String // 'Q3/2026' (reward QUARTER) | '2026' (reward YEAR)
  rewardTitle     String
  rewardType      DealerRewardType
  rewardPeriod    String // QUARTER | YEAR tại thời điểm yêu cầu
  threshold       BigInt
  volumeAtClaim   BigInt // doanh số ĐÃ CHỐT của kỳ lúc gửi yêu cầu
  note            String? // ghi chú của đại lý
  status          DealerRewardClaimStatus @default(PENDING)
  reviewedBy      String? // adminId duyệt/từ chối
  reviewedAt      DateTime?
  rejectionReason String?
  paidBy          String? // adminId xác nhận đã trao thưởng
  paidAt          DateTime?
  adminNote       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([userId, periodKey, rewardId])
  @@index([status, createdAt])
  @@map("dealer_reward_claims")
}

model ReferralTouch {
  id             String   @id @default(cuid())
  userId         String   @unique // khách đã đăng nhập
  referrerUserId String // CTV được công (đã resolve từ referralCode lúc ghi)
  storefrontSlug String? // chỉ set khi đến từ gian hàng CTV (kind=ctv); brand → null
  kind           String   @default("ctv") // ctv | brand
  expiresAt      DateTime // now + config(affiliate.attribution_days, mặc định 7 ngày)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@map("referral_touches")
}

model Storefront {
  id                  String                   @id @default(cuid())
  type                StorefrontType
  /// Gian hàng đối tác (tự đăng sản phẩm, tự giao, đối soát). Bền, không suy từ vai trò hiện tại của chủ: CTV đã mở gian hàng rồi
  /// được duyệt đại lý giữ type CTV (hoa hồng giới thiệu không đổi) nhưng được bật cờ này. Tự tắt khi chủ rơi xuống CUSTOMER/AFFILIATE
  /// (từ DEALER/STAFF/ADMIN) và gian hàng hết vướng mắc; còn vướng thì việc đổi vai trò bị 409. DEALER lên STAFF/ADMIN không đụng cờ.
  isPartner           Boolean                  @default(false)
  slug                String                   @unique
  subdomain           String?                  @unique
  customDomain        String?                  @unique
  ownerUserId         String?
  owner               User?                    @relation(fields: [ownerUserId], references: [id])
  brandId             String?                  @unique
  brand               Brand?                   @relation(fields: [brandId], references: [id])
  title               String
  headerNote          String?
  avatarUrl           String?
  coverUrl            String?
  theme               String                   @default("leaf-orange")
  themeColor          String?                  @default("#16a34a")
  bankName            String?
  bankBin             String?
  bankAccountNo       String?
  bankAccountName     String?
  warehouseAddress    String?
  warehouseCity       String?
  warehouseDistrict   String?
  warehouseWard       String?
  warehousePhone      String?
  /// Phí giao mỗi kiện của đối tác tự giao (NULL = merchant.default_shipping_fee).
  shippingFee         Int?
  /// Kiện của đối tác có tiền hàng từ mức này được miễn phí giao (NULL = không miễn phí).
  freeShipFrom        Int?
  /// Phí sàn riêng cho gian hàng (phân số, 0.15 = 15%). NULL = merchant.commission_pct. Chỉ admin đặt.
  commissionPct       Decimal?                 @db.Decimal(5, 4)
  /// Phí vận hành "Tubu giao hộ" theo tiền hàng khách thực trả (phân số), trừ thêm ngoài phí sàn khi đối soát. Chỉ admin đặt.
  consignmentFeePct   Decimal                  @default(0) @db.Decimal(5, 4)
  /// Phí vận hành "Tubu giao hộ" cố định mỗi đơn (đồng), chia cho các dòng hàng giao hộ của gian hàng trong đơn. Chỉ admin đặt.
  consignmentFeeFixed Int                      @default(0)
  /// Đối tác bật "Tạm nghỉ": hàng tự giao của gian hàng không đặt được tới khi tắt (R2-MERCHANT-13). NULL = đang nhận đơn.
  ordersPausedAt      DateTime?
  isPublished         Boolean                  @default(false)
  publishedAt         DateTime?
  /// Gian hàng mẫu để giới thiệu tính năng (chỉ tạo bằng script seed:sample-storefronts trên máy thử). Khách vẫn mở được bằng link
  /// và thấy nhãn "Gian hàng mẫu", nhưng không lên danh sách công khai, không ghi công đơn và không sinh hoa hồng.
  isSample            Boolean                  @default(false)
  /// Admin duyệt gian hàng CTV (tick xanh, nhãn "CTV tuyển chọn"). NULL = chưa duyệt. Gian hàng đối tác và nhãn hàng luôn tính là đã duyệt
  /// (không đọc cột này): đối tác đã qua bước duyệt đại lý, nhãn hàng do admin tạo.
  approvedAt          DateTime?
  approvedById        String?
  /// Admin gỡ đăng vì vi phạm: chủ không đăng lại được cho tới khi admin đăng lại. NULL = không bị gỡ. Giữ `publishedAt` nguyên để
  /// "Đăng lại" khôi phục đúng trạng thái trước khi gỡ.
  takenDownAt         DateTime?
  takenDownReason     String?
  takenDownById       String?
  collections         StorefrontCollection[]
  products            Product[]                @relation("StorefrontProducts")
  fulfilledOrders     Order[]                  @relation("OrderFulfiller")
  attributedOrders    Order[]                  @relation("OrderStorefront")
  merchantPayouts     MerchantPayout[]
  termsHistory        StorefrontTermsHistory[]
  /// Mốc lần cuối nhắc CTV thêm sản phẩm nổi bật còn thiếu vào gian hàng (storefront-reminder.service.ts).
  /// Null = chưa từng nhắc. Chỉ dùng cho guard chống gửi trùng, không phải mốc nghiệp vụ khác.
  lastReminderAt      DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([ownerUserId])
  @@index([ownerUserId])
  @@index([subdomain])
  @@map("storefronts")
}

model StorefrontCollection {
  id               String           @id @default(cuid())
  storefrontId     String
  storefront       Storefront       @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  title            String
  kind             CollectionKind   @default(NORMAL)
  layout           CollectionLayout @default(CAROUSEL)
  sortOrder        Int              @default(0)
  comboDiscountPct Int?
  items            StorefrontItem[]

  @@index([storefrontId])
  @@map("storefront_collections")
}

model StorefrontItem {
  id           String               @id @default(cuid())
  collectionId String
  collection   StorefrontCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product              @relation(fields: [productId], references: [id])
  variationId  String?
  note         String?
  sortOrder    Int                  @default(0)
  isPinned     Boolean              @default(false)
  isHidden     Boolean              @default(false)

  @@index([collectionId])
  @@index([productId])
  @@map("storefront_items")
}

model Variation {
  id                            String    @id @default(cuid())
  /// NULL = biến thể không có trên Pancake (sản phẩm đối tác tự giao).
  pancakeId                     String?   @unique
  productId                     String
  product                       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                           String    @unique
  name                          String
  attributes                    Json
  retailPrice                   Int
  salePrice                     Int?
  dealerPrices                  Json? // {tier_silver: 200000, tier_gold: 190000}
  affiliateRate                 Decimal? // % hoa hồng CTV (import Excel) — spec 15.2 affiliate.product_rate_source
  /// Tồn kho BÁN ĐƯỢC — mọi nơi kiểm tồn/hiển thị đọc đúng cột này (không đổi).
  stock                         Int       @default(0)
  /// Số `remain_quantity` mà Pancake báo ở lần đồng bộ gần nhất. NULL = chưa từng đồng bộ
  /// (sản phẩm do merchant tự tạo, hoặc variation có trước khi có cơ chế này).
  pancakeStock                  Int?
  /// Số đơn vị đã bán bằng đơn CỦA TA mà số liệu Pancake chưa phản ánh.
  /// Sync tính `stock = pancakeStock_mới − reservedStock`, và mỗi khi số Pancake GIẢM thì trừ
  /// bấy nhiêu khỏi `reservedStock`. Nhờ đó công thức đúng cho cả hai trường hợp: Pancake có
  /// tự trừ tồn khi ta tạo đơn (số giảm ⇒ nhả giữ chỗ) lẫn không tự trừ (số đứng yên ⇒ giữ chỗ
  /// còn nguyên). Xem docs/2026-09-11-P0-3-pancake-stock-decision-brief.md.
  reservedStock                 Int       @default(0)
  /// `updated_at` (giờ Pancake) của webhook tồn kho gần nhất đã áp. Chỉ so webhook với webhook (Pancake gửi không theo thứ
  /// tự, BullMQ thử lại): webhook cũ hơn mốc này tới sau thì không áp. NULL = chưa áp webhook nào có mốc giờ. Đồng bộ danh mục
  /// không đọc/ghi cột này: `updated_at` không mang múi giờ, Node đọc theo múi giờ của tiến trình, nên không bao giờ so nó với
  /// đồng hồ máy chủ — lượt đồng bộ đi bằng hai cột dưới.
  pancakeStockEventAt           DateTime?
  /// Lúc (giờ máy chủ Tubu) lượt đồng bộ danh mục bắt đầu đọc trang Pancake mang số tồn đang áp. Webhook tồn kho NHẬN trước
  /// mốc này (hàng đợi chậm, Redis sập rồi xử lý sau) mang số cũ hơn lần đọc nên không áp. NULL = chưa lượt đồng bộ nào áp mốc.
  pancakeStockSyncReadAt        DateTime?
  /// Lúc (giờ máy chủ Tubu, `PancakeWebhookEvent.receivedAt`) nhận webhook tồn kho muộn nhất đã áp. Lượt đồng bộ bắt đầu đọc
  /// trước mốc này thì không ghi đè (webhook có thể mới hơn số nó đã đọc). NULL = chưa áp webhook nào kể từ khi có cột.
  pancakeStockWebhookReceivedAt DateTime?
  isActive                      Boolean   @default(true)
  /// Lý do đồng bộ Pancake tự tắt biến thể: REMOVED (Pancake xoá / không còn trong danh mục) | NO_PRICE
  /// (tạo mới mà thiếu giá). NULL = đồng bộ không giữ — isActive=false khi đó là do admin/merchant tắt,
  /// đồng bộ không được tự bật lại.
  pancakeHold                   String?
  weight                        Int?

  cartItems          CartItem[]
  dealerPriceHistory DealerPriceHistory[]
  subscriptions      Subscription[]
  flashSaleItems     FlashSaleItem[]
  pancakeLinks       MerchantPancakeLink[]

  @@index([productId])
  @@map("variations")
}

model FlashSale {
  id        String          @id @default(cuid())
  title     String
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean         @default(true)
  createdBy String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FlashSaleItem[]

  @@index([isActive, startAt, endAt])
  @@map("flash_sales")
}

model FlashSaleItem {
  id           String              @id @default(cuid())
  flashSaleId  String
  flashSale    FlashSale           @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variationId  String
  variation    Variation           @relation(fields: [variationId], references: [id])
  flashPrice   Int
  quota        Int
  soldCount    Int                 @default(0)
  perUserLimit Int
  purchases    FlashSalePurchase[]
  reminders    FlashSaleReminder[]

  @@unique([flashSaleId, variationId])
  @@index([variationId])
  @@map("flash_sale_items")
}

model FlashSalePurchase {
  id              String        @id @default(cuid())
  flashSaleItemId String
  item            FlashSaleItem @relation(fields: [flashSaleItemId], references: [id], onDelete: Cascade)
  userId          String
  quantity        Int           @default(0)
  updatedAt       DateTime      @updatedAt

  @@unique([flashSaleItemId, userId])
  @@index([userId])
  @@map("flash_sale_purchases")
}

/// Nhắc user khi flash sale sắp diễn ra bắt đầu bán (§ Nhắc tôi).
model FlashSaleReminder {
  id              String        @id @default(cuid())
  userId          String
  flashSaleItemId String
  item            FlashSaleItem @relation(fields: [flashSaleItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  notifiedAt      DateTime?

  @@unique([userId, flashSaleItemId])
  @@index([flashSaleItemId])
  @@map("flash_sale_reminders")
}

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  parent    Category?  @relation("CatParent", fields: [parentId], references: [id])
  children  Category[] @relation("CatParent")
  name      String
  slug      String     @unique
  image     String?
  sortOrder Int        @default(0)

  @@map("categories")
}

// CTV Content Kit (Bộ nội dung bán hàng) — thư viện bài mẫu/USP/FAQ/media theo từng sản phẩm,
// CTV copy & chia sẻ, tự chèn tên CTV + link giới thiệu (placeholder {ten_ctv}/{link}).
model ProductContentKit {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  captions  String[] @default([]) // bài mẫu, có thể chứa {ten_ctv} và {link}
  usps      String[] @default([]) // điểm bán hàng
  faqs      Json? // [{q,a}]
  videoUrls String[] @default([])
  updatedAt DateTime @updatedAt

  @@map("product_content_kits")
}

// ============================================================
// 4.3 Giỏ hàng & đơn
// ============================================================

model Cart {
  id                String     @id @default(cuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             CartItem[]
  couponCode        String?
  updatedAt         DateTime   @updatedAt
  // Remarketing (nhắc giỏ bỏ quên): null/cũ hơn updatedAt = chưa nhắc cho lần bỏ quên này.
  abandonRemindedAt DateTime?

  @@map("carts")
}

model CartItem {
  id          String    @id @default(cuid())
  cartId      String
  cart        Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variationId String
  variation   Variation @relation(fields: [variationId], references: [id])
  quantity    Int

  @@unique([cartId, variationId])
  @@map("cart_items")
}

enum OrderType {
  RETAIL
  DEALER
}

enum FulfilmentMode {
  TUBU
  MERCHANT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPING
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  COD
  ZALOPAY
  VNPAY
  BANK_TRANSFER
  WALLET
  XU
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum InvoiceStatus {
  NOT_REQUESTED
  REQUESTED
  ISSUED
  FAILED
}

model Order {
  id                     String                @id @default(cuid())
  code                   String                @unique
  idempotencyKey         String?               @unique // chống double-submit place-order (§12.1)
  pancakeOrderId         String?               @unique
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id])
  type                   OrderType
  status                 OrderStatus
  subtotal               Int
  discount               Int                   @default(0)
  // Các phần của `discount` để khách đối chiếu từng khoản giảm. Đơn tạo trước khi có các cột này để 0 cả bốn.
  couponDiscount         Int                   @default(0)
  comboDiscount          Int                   @default(0)
  tierDiscount           Int                   @default(0)
  pointsDiscount         Int                   @default(0)
  shippingFee            Int                   @default(0)
  total                  Int
  pointsEarned           Int                   @default(0)
  pointsUsed             Int                   @default(0)
  // Phần của pointsUsed lấy từ lô CONVERTED (PD-3); phần STANDARD = pointsUsed − pointsUsedConverted.
  // Cần để hoàn điểm khi huỷ/trả về đúng lô.
  pointsUsedConverted    Int                   @default(0)
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus
  paymentTxnId           String?
  shippingAddress        Json
  /// Tên người nhận đã gấp dấu (vn_search_fold của shippingAddress.recipient), trigger orders_recipient_search_sync giữ
  /// đồng bộ — admin tìm đơn tặng theo tên người nhận, có hoặc không dấu.
  recipientSearch        String                @default("")
  shippingPartner        String?
  shippingCode           String?
  shippingStatus         String?
  trackingLink           String?
  shippingHistory        Json?
  invoiceRequest         Json?
  invoiceUrl             String?
  invoiceStatus          InvoiceStatus?        @default(NOT_REQUESTED)
  referrerUserId         String?
  storefrontSlug         String?
  /// Gian hàng được ghi công, resolve phía server lúc đặt (slug/subdomain/tên miền → id). Lọc đơn của gian hàng theo cột
  /// này, không theo chuỗi storefrontSlug (subdomain đổi chủ được).
  storefrontId           String?
  storefront             Storefront?           @relation("OrderStorefront", fields: [storefrontId], references: [id])
  /// Nơi giao cả đơn: TUBU (kho Tubu qua Pancake) hoặc MERCHANT (gian hàng fulfillerStorefrontId tự giao).
  fulfiller              FulfilmentMode        @default(TUBU)
  fulfillerStorefrontId  String?
  fulfillerStorefront    Storefront?           @relation("OrderFulfiller", fields: [fulfillerStorefrontId], references: [id])
  /// Phí sàn chốt lúc đặt đơn đối tác (phân số). Đối soát đọc số này.
  merchantCommissionPct  Decimal?              @db.Decimal(5, 4)
  /// Mã đơn đầu của lần đặt bị tách theo nơi giao; mọi đơn cùng lần đặt cùng giá trị. NULL = không tách.
  checkoutGroup          String?
  /// Đối tác bấm "Xác nhận" đơn tự giao.
  merchantAcceptedAt     DateTime?
  /// Lúc đơn tự giao được giao cho đơn vị vận chuyển (đối tác nhập hãng + mã vận đơn).
  shippedAt              DateTime?
  /// Lần gần nhất nhắc đối tác đơn quá hạn xử lý.
  merchantSlaNotifiedAt  DateTime?
  // Đơn CTV "lên đơn hộ khách": userId==referrerUserId (CTV) nhưng VẪN được hưởng hoa hồng
  // (cho phép self-referral có kiểm soát — xem affiliate.createCommissionForOrder).
  placedForCustomer      Boolean               @default(false)
  /// @deprecated Không nơi nào ghi hoặc đọc, luôn 0 (C-108); hoa hồng CTV nằm ở bảng commissions.
  commission             Int                   @default(0)
  source                 String? // checkout | buy_now | storefront | ctv_assisted | subscription | dealer
  platform               String? // miniapp | web — null cho đơn cũ trước migration này
  paidAt                 DateTime? // lúc paymentStatus chuyển PAID — set tại nơi lật trạng thái
  subscriptionId         String? // gắn khi đơn tạo từ subscriptions.service (cron chạy kỳ)
  endCustomerKey         String? // SĐT người nhận dạng nội địa 0xxxxxxxxx (lưu rõ, KHÔNG hash) — CHỈ set khi placedForCustomer = true
  couponCode             String?
  note                   String?
  // Thu gom vật liệu tái chế (Gomdon đơn đổi hàng)
  hasRecyclingPickup     Boolean               @default(false)
  recyclingNote          String?
  gomdonOrderId          String?
  gomdonPartnerCode      String?
  /// Trạng thái vận đơn Gomdon: mã số Gomdon ("1".."12") HOẶC trạng thái nội bộ
  /// (AWAITING_PAYMENT | CREATING | NEEDS_MANUAL_CHECK | FAILED | NOT_CONFIGURED) — xem gomdon-status.ts.
  gomdonStatus           String?
  /// Thời điểm (created_time từ Gomdon) của trạng thái Gomdon đang lưu — chặn webhook tới trễ lùi trạng thái.
  gomdonStatusAt         DateTime?
  /// Kết quả huỷ vận đơn Gomdon khi đơn bị huỷ: CANCELLED | FAILED | TOO_LATE | NOT_NEEDED | MANUAL_HANDLED
  /// (null = chưa xử lý).
  gomdonCancelStatus     String?
  /// Mốc bắt đầu tự thử lại huỷ vận đơn sau lỗi tạm của Gomdon (cron cứu hộ thử lại trong một cửa sổ). null =
  /// không tự thử lại: chưa lỗi, hoặc Gomdon trả lời dứt khoát (vd "Không tìm thấy đơn hàng").
  gomdonCancelRetrySince DateTime?
  /// Số lần tạo lại vận đơn sau khi vận đơn cũ đã huỷ. Gomdon chặn trùng order_customer_id (kể cả vận đơn đã
  /// huỷ) nên lần tạo lại thứ n gửi `${code}-R${n}` — xem gomdonCustomerId().
  gomdonAttempt          Int                   @default(0)
  gomdonAlerts           GomdonAlert[]
  /// Thời điểm đơn chuyển DELIVERED (OrderStatusService.setStatus) — mốc tính hạn đổi/trả. Trước đây
  /// dùng updatedAt: mọi lần ghi sau đó (webhook vận chuyển, yêu cầu hoá đơn…) kéo dài hạn đổi/trả.
  deliveredAt            DateTime?
  /// Lúc mọi việc sau giao đã xong (cộng Điểm Xanh, khoá hoa hồng CTV, xét thưởng giới thiệu) — các việc đó chạy sau khi lần lật
  /// DELIVERED commit nên có thể lỡ; null trên đơn DELIVERED quá 10 phút = DeliveredEffectsResyncCron chạy lại.
  deliveredEffectsAt     DateTime?
  /// Lúc mọi việc sau commit của lần huỷ/trả đã xong (đảo điểm tích và điểm thường còn lại, thu hồi hoa hồng, xếp lệnh huỷ
  /// Pancake/Gomdon, báo khách) — các việc đó chạy sau khi lần lật CANCELLED/RETURNED commit nên tiến trình chết giữa chừng làm
  /// lỡ; null trên đơn CANCELLED/RETURNED quá vài phút = ReversalEffectsResyncCron chạy lại. Đơn huỷ/trả trước migration được
  /// điền sẵn (không quét lại lịch sử). Đơn chưa đóng luôn null.
  reversalEffectsAt      DateTime?
  /// Lúc cron ReviewInviteService nhận đơn để gửi tin mời đánh giá (claim trước khi gửi, null lại nếu gửi lỗi).
  reviewInvitedAt        DateTime?
  /// Hàng đợi "Cần xử lý Pancake": lý do mới nhất Pancake báo một việc hệ thống không tự làm được (đang hoàn,
  /// hoàn một phần, đơn bị xoá, trạng thái mâu thuẫn, đơn Pancake lạ mang mã đơn này...). Null = không có việc.
  pancakeAttention       String?
  /// Lúc ghi lý do cần xử lý gần nhất — admin bấm "Đã xử lý" thì cả hai cột về null.
  pancakeAttentionAt     DateTime?
  /// Lúc hệ thống thử tự huỷ (hết hạn thanh toán) mà đơn đã bàn giao vận chuyển — D1 không cho huỷ nữa. Cron hết hạn bỏ qua
  /// đơn này (không thử lại, không nhắc lại mỗi lượt); người vận hành xử lý theo lời nhắc ở "Cần xử lý Pancake".
  autoCancelBlockedAt    DateTime?
  /// Số tiền chuyển khoản (cộng dồn) Pancake báo đã nhận khi đơn còn chưa đủ tiền — đơn bị huỷ thì hoàn đúng số này.
  pancakePaidReported    Int?
  /// Đẩy đơn sang Pancake (pancake-order.service.ts): WAITING_PAYMENT (trả trước qua cổng, chờ tiền) | PENDING
  /// (đang thử lại) | PUSHING | SYNCED | FAILED (hết lượt thử, cron vẫn thử tiếp trong cửa sổ) | NOT_CONFIGURED |
  /// SKIPPED (đơn đã huỷ/trả trước khi lên Pancake) | STALE (quá cửa sổ tự đẩy hoặc đã rời kho mà chưa lên Pancake —
  /// kiểm tra tay). Null = đơn cũ trước cột này.
  pancakePushStatus      String?
  /// Lỗi gần nhất khi gọi Pancake cho đơn này (tạo / cập nhật thanh toán / huỷ) — hiện cho admin.
  pancakeSyncError       String?
  pancakePushAttempts    Int                   @default(0)
  pancakeLastAttemptAt   DateTime?
  /// Mốc gửi lệnh tạo đơn mà CHƯA biết kết quả (timeout, mất response, chết giữa chừng). Còn giá trị khi chưa có
  /// pancakeOrderId nghĩa là Pancake CÓ THỂ đã tạo đơn: phải tra theo mã đơn trước khi tạo lại.
  pancakePushClaimedAt   DateTime?
  /// Đơn Pancake đã mang thông tin "không thu COD" (đã trả trước / công nợ đại lý). false + đơn đã PAID = còn phải
  /// cập nhật sang Pancake.
  pancakePaymentSynced   Boolean               @default(false)
  /// Huỷ đơn bên Pancake khi đơn huỷ ở Tubu: PENDING | CANCELLED | NOT_FOUND | TOO_LATE (Pancake đã gửi hàng) |
  /// FAILED (hết lượt thử). Null = không cần (chưa từng lên Pancake, Pancake tự huỷ) hoặc đơn cũ.
  pancakeCancelStatus    String?
  items                  OrderItem[]
  commissions            Commission[]
  paymentAttempts        PaymentAttempt[]
  customerRefunds        OrderCustomerRefund[]
  merchantPayoutLines    MerchantPayoutLine[]
  wasteRequest           WasteRequest?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId, status])
  /// Báo cáo nguồn khách: đơn đầu/đơn hai của từng khách theo thời gian.
  @@index([userId, createdAt])
  @@index([referrerUserId])
  @@index([storefrontSlug])
  // Admin order listing lọc theo status, sort createdAt desc (admin.service.ts listOrders) —
  // không trùng prefix với [userId, status] ở trên (userId không có trong where của admin).
  @@index([status, createdAt])
  // Danh sách đơn admin không lọc + đơn mới nhất của dashboard: ORDER BY createdAt DESC LIMIT n.
  @@index([createdAt])
  @@index([gomdonOrderId])
  @@index([gomdonPartnerCode])
  // Tìm đơn admin theo mã đơn / mã Gomdon (ILIKE '%x%') — trigram GIN, cần extension pg_trgm.
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_code_trgm_idx")
  @@index([gomdonPartnerCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_gomdonPartnerCode_trgm_idx")
  // Tìm đơn admin theo mã vận đơn hãng (GHN/GHTK... Pancake ghi vào shippingCode).
  @@index([shippingCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_shippingCode_trgm_idx")
  // Tìm đơn admin theo tên người nhận không dấu ("recipientSearch" LIKE '%x%').
  @@index([recipientSearch(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_recipientSearch_trgm_idx")
  // Cron cứu hộ Gomdon (gomdon-reconcile.service.ts) quét đơn thu gom theo gomdonStatus.
  @@index([hasRecyclingPickup, gomdonStatus])
  // Hàng đợi "Cần xử lý Pancake" của admin: WHERE pancakeAttentionAt IS NOT NULL ORDER BY pancakeAttentionAt.
  @@index([pancakeAttentionAt])
  // Bộ lọc admin "Chưa lên Pancake" và cron cứu hộ (đẩy lại / huỷ lại / cập nhật thanh toán).
  @@index([pancakePushStatus])
  @@index([pancakeCancelStatus])
  @@index([fulfillerStorefrontId, status, createdAt])
  @@index([storefrontId, createdAt])
  @@index([checkoutGroup])
  // Bộ lọc danh sách đơn admin (loại đơn, thanh toán, nền tảng; admin-order-filter.ts): mỗi lọc kèm sắp xếp createdAt.
  @@index([paymentStatus, createdAt])
  @@index([type, createdAt])
  @@index([platform, createdAt])
  @@index([placedForCustomer, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String               @id @default(cuid())
  orderId             String
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variationId         String
  productName         String
  // Slug SP tại thời điểm mua — snapshot như productName. Không có nó thì từ đơn hàng không
  // mở được trang sản phẩm: khách nhận hàng xong KHÔNG có lối nào để đánh giá (P1-2, audit
  // mạch lạc B2C), và "mua lại từng món" cũng không dẫn đi đâu được. Nullable cho đơn cũ.
  productSlug         String?
  variationName       String
  unitPrice           Int
  quantity            Int
  total               Int
  /// Tiền khách thực trả cho dòng lúc đặt: `total` trừ phần mã giảm giá, giảm hạng, Điểm Xanh mà checkout chia về đúng
  /// dòng được hưởng (mã gắn sản phẩm chỉ dòng sản phẩm đó; mã/hạng không vào hàng flash; Điểm Xanh chỉ vào dòng hàng Tubu). Nền hoàn tiền, hoa hồng CTV và
  /// đối soát đối tác. Null ở đơn cũ và đơn không qua checkout — các nơi đọc chia `total − shippingFee` theo giá trị dòng.
  paidTotal           Int?
  /// Phần Điểm Xanh (đồng) checkout trừ vào dòng lúc đặt — chỉ dòng hàng Tubu nhận điểm, hàng của gian hàng đối tác luôn 0.
  /// Trả hàng hoàn điểm theo đúng phần này. Null ở đơn cũ và đơn không qua checkout — trả hàng chia điểm theo giá trị dòng.
  pointsDiscount      Int?
  flashSaleItemId     String?
  /// Số đơn vị của dòng này CHƯA có hàng thật để giữ chỗ — chỉ > 0 cho đơn ĐẠI LÝ khi đặt vượt
  /// tồn (§ DealerService.placeOrder cho đặt trước thay vì từ chối). Với mọi đơn khác luôn 0.
  /// `quantity - backorderedQty` là số đã thực sự trừ kho (dùng khi hoàn kho lúc huỷ/trả).
  backorderedQty      Int                  @default(0)
  merchantPayoutLines MerchantPayoutLine[]

  @@index([orderId])
  // Đối soát đặt trước quét OrderItem theo variation + còn thiếu hàng — cần nhanh, chạy mỗi
  // chu kỳ đồng bộ Pancake.
  @@index([variationId, backorderedQty])
  @@map("order_items")
}

// ============================================================
// 4.4 Loyalty & Voucher
// ============================================================

// PD-3: lô của một dòng sổ Điểm Xanh. STANDARD = điểm thưởng thường (users.pointsBalance);
// CONVERTED = điểm quy từ xu (users.pointsConvertedBalance), luôn expiresAt NULL.
enum PointsLot {
  STANDARD
  CONVERTED
}

model PointsTransaction {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  delta     Int
  reason    String
  refType   String?
  refId     String?
  expiresAt DateTime?
  // CHECK points_transactions_converted_no_expiry (lot <> CONVERTED OR expiresAt IS NULL) chỉ có trong SQL.
  lot       PointsLot @default(STANDARD)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, refId])
  // Cron loyalty-expiry.service.ts (expirePoints/remindExpiringPoints) quét
  // WHERE delta>0 AND expiresAt <=/BETWEEN now — không có index này sẽ full-scan bảng lớn mỗi đêm.
  @@index([expiresAt])
  // Partial unique (thêm bằng SQL tay, Prisma không khai báo được WHERE — migration
  // 20260926120000_loyalty_checkin_pos):
  //  - "points_transactions_checkin_day_key" ON ("userId","refId") WHERE refType='CHECKIN'
  //    (refId = ngày VN 'YYYY-MM-DD') → tối đa 1 dòng điểm danh/user/ngày.
  //  - "points_transactions_pos_ref_key" ON ("refId") WHERE refType='POS'
  //    (refId = PosPointCredit.id) → 1 lần tích POS chỉ sinh đúng 1 dòng điểm.
  // PD-3 (20261012100000_pd3_points_lot_schema): *_xu_migration_key (refId) WHERE refType='XU_MIGRATION',
  // *_referral_unique (reason) WHERE refType='REFERRAL', *_community_reason_key (reason) WHERE
  // refType='COMMUNITY', *_quest_unique (userId, reason) WHERE refType='QUEST',
  // *_converted_refund_unique (reason, refId) WHERE ORDER_REFUND_CONVERTED:% / ORDER_REFUND_XU:%.
  // Đổi rác lấy quà (20261020000000_waste_exchange): points_transactions_recycle_ref_key, points_transactions_recycle_reverse_key
  // và points_transactions_gift_refund_key, đều (refId) WHERE refType = 'RECYCLE' / 'RECYCLE_REVERSED' / 'GIFT_REFUND'.
  // Thu hồi thưởng đánh giá khi trả hàng (20261020100000_review_return_reversal): points_transactions_review_return_key (reason)
  // WHERE refType = 'REVIEW' AND reason LIKE 'REVIEW_RETURN:%'.
  @@map("points_transactions")
}

// PD-3 Q-03a: ảnh chụp lần quy đổi xu → Điểm Xanh (migration 20261012110000_pd3_xu_to_points), một dòng
// mỗi user có xu lúc quy đổi. PK userId là một trong các lớp chặn quy đổi hai lần; SQL hoàn tác
// prisma/manual/pd3_xu_to_points_rollback.sql đọc bảng này. CHECK roundingVnd 0..999 chỉ có trong SQL.
model XuPointsConversion {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id])
  coinsBefore     Int
  pointsBefore    Int
  convertedBefore Int
  pointsGranted   Int
  roundingVnd     Int // pointsGranted*1000 − coinsBefore
  pointsTxId      String
  coinTxId        String
  convertedAt     DateTime @default(now())

  @@map("xu_points_conversions")
}

/// Điểm danh hằng ngày nhận Điểm Xanh ở trang Hạng thành viên (loyalty.service.ts dailyCheckIn).
/// TÁCH HẲN khỏi điểm danh Vườn Xanh (GameProfile.lastCheckInAt/streakDays do
/// game-economy.service.ts quản, có vé giữ lửa + hồi sinh chuỗi): trước đây loyalty dùng chung
/// 2 cột đó → điểm danh bên này chặn bên kia trong ngày và vòng 7 ngày ghi đè chuỗi game.
/// Unique (userId, dayKey) là chốt chặn cứng: 2 request song song cùng ngày thì request thứ hai
/// ăn P2002 TRƯỚC khi kịp cộng điểm.
model LoyaltyCheckIn {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey     String // 'YYYY-MM-DD' theo giờ Việt Nam (UTC+7)
  cycleDay   Int // 1..7 trong vòng thưởng 7 ngày
  streakDays Int // số ngày liên tiếp (không giới hạn, chỉ để hiển thị)
  points     Int // điểm đã cộng lần này (theo loyalty.checkin_points tại thời điểm điểm danh)
  createdAt  DateTime @default(now())

  @@unique([userId, dayKey])
  @@map("loyalty_check_ins")
}

/// Sổ ghi vết tích điểm hoá đơn tại quầy (POS) do nhân viên nhập — ai cộng, cho ai, hoá đơn nào,
/// bao nhiêu. receiptId unique = khoá idempotency: 1 hoá đơn chỉ tích điểm 1 lần (retry mạng/bấm
/// đúp trả lại kết quả cũ). dayKey để cộng dồn trần điểm/ngày theo nhân viên và theo thành viên.
model PosPointCredit {
  id          String   @id @default(cuid())
  receiptId   String   @unique
  memberId    String
  member      User     @relation("PosCreditMember", fields: [memberId], references: [id])
  staffUserId String
  staff       User     @relation("PosCreditStaff", fields: [staffUserId], references: [id])
  orderTotal  Int
  points      Int
  multiplier  Decimal
  note        String?
  dayKey      String // 'YYYY-MM-DD' theo giờ Việt Nam (UTC+7)
  createdAt   DateTime @default(now())

  @@index([staffUserId, dayKey])
  @@index([memberId, dayKey])
  @@map("pos_point_credits")
}

// Mỗi lần bấm thanh toán cổng (ZaloPay...) = 1 dòng. Trước đây chỉ có Order.paymentTxnId lưu
// lần thử MỚI NHẤT: khách bấm thanh toán hôm nay rồi bỏ dở, mai bấm lại (app_trans_id có tiền
// tố ngày nên khác), sau đó hoàn tất giao dịch của HÔM QUA → callback mang app_trans_id cũ,
// tra theo paymentTxnId không khớp gì cả, handler im lặng trả success trong khi TIỀN ĐÃ THU và
// đơn vẫn UNPAID. Lưu từng lần thử + khoá unique theo appTransId để callback nào cũng khớp
// đúng đơn, và đối chiếu được số tiền (P2, docs/2026-09-08-review-progress.md).
model PaymentAttempt {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String // ZALOPAY | VNPAY ...
  appTransId    String    @unique
  amount        Int // số tiền kỳ vọng lúc tạo lệnh — dùng đối chiếu với callback
  createdAt     DateTime  @default(now())
  /// Cổng đã cho kết quả cuối (callback hoặc tra trạng thái: đã trả / thất bại / hết hạn) — cron đối soát thôi hỏi.
  resolvedAt    DateTime?
  lastQueriedAt DateTime?
  /// Lần thử này là khoản đã lật đơn sang PAID — callback/tra cứu sau của chính nó là gửi lại, của lần thử khác là tiền trả thêm.
  succeededAt   DateTime?

  @@index([orderId])
  @@index([provider, resolvedAt, createdAt])
  @@map("payment_attempts")
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int // +thưởng/đổi-vào, -tiêu
  reason    String // CONVERT_FROM_WALLET | REFERRAL_CASHBACK:<id> | REFERRED_CASHBACK:<id> | ORDER_PAY:<code> | GAME_BUY_SEEDS | GAME_BUY_TREE:<cert>
  refType   String? // CONVERT | REFERRAL | ORDER | GAME | ADMIN
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("coin_transactions")
}

// Sổ cái Ví Tubu (walletBalance — VND thật, chỉ dùng trả tiền hàng). Bất biến: users.walletBalance ==
// SUM(delta) theo userId; mọi biến động đi qua WalletLedgerService.applyDelta trong cùng
// transaction với thay đổi số dư. Ghi từ ngày triển khai: mỗi user có số dư <> 0 lúc migrate có
// đúng 1 dòng OPENING (Q-04, migration 20261010041004_wallet_ledger) — không dựng lại lịch sử cũ.
enum WalletTxType {
  OPENING // số dư đầu kỳ khi bắt đầu ghi sổ
  ORDER_PAY // trả đơn bằng ví
  ORDER_REFUND // hoàn tiền đơn huỷ/trả về ví
  COMMISSION_PAYOUT // hoa hồng CTV chuyển vào ví
  CASHBACK // cashback hết hold chuyển vào ví
  WITHDRAW // rút về ngân hàng: dòng cũ, không còn tạo mới (gross = tiền chuyển + phí)
  WITHDRAW_REFUND // admin từ chối lệnh rút → hoàn gross
  XU_CONVERT // đổi ví sang TubuXu
  MERGE_IN // nhận số dư từ tài khoản khách bị gộp
  MERGE_OUT // chuyển số dư sang tài khoản được gộp vào
  ADJUST // điều chỉnh tay của admin
  PIT_REFUND // hoàn thuế TNCN giữ dư khi admin từ chối một lệnh rút hoa hồng cùng tháng
}

model WalletTransaction {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  delta        Int // VND, có dấu: + vào ví, - ra khỏi ví
  balanceAfter Int // walletBalance ngay sau dòng này
  type         WalletTxType
  refType      String? // ORDER | PAYOUT | CASHBACK | USER | ...
  // Khoá chống ghi trùng: (userId, type, refId) unique; refId NULL không bị ràng buộc (Postgres
  // coi NULL là khác nhau) nên chỉ biến động không có tham chiếu (ADJUST tay) mới để NULL.
  refId        String?
  reason       String?
  createdAt    DateTime     @default(now())

  @@unique([userId, type, refId])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

enum CouponType {
  PERCENT
  AMOUNT
  FREESHIP
}

enum CouponScope {
  PUBLIC
  TIER
  USER_GROUP
  BIRTHDAY
  INVITE
  // Mã ẩn (thẻ in bỏ hộp hàng): chỉ vào ví của khách đã nhận qua link `?claim=` hoặc gõ mã ở giỏ (coupon_claims).
  CLAIM
}

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  type            CouponType
  value           Int
  minOrder        Int?
  maxDiscount     Int?
  startAt         DateTime
  endAt           DateTime
  usageLimit      Int?
  usedCount       Int                @default(0) // B4: bộ đếm atomic dùng cho updateMany guard
  perUserLimit    Int                @default(1)
  // { productIds: string[] } = chỉ áp khi giỏ có các sản phẩm đó, mức giảm/minOrder tính trên chúng.
  applyTo         Json?
  isStackable     Boolean            @default(false)
  // Admin tắt mã (lộ mã/đặt nhầm giá trị) mà không xoá lịch sử dùng.
  isActive        Boolean            @default(true)
  scope           CouponScope
  scopeMeta       Json?
  redemptions     CouponRedemption[]
  // Remarketing (nhắc voucher cá nhân sắp hết hạn): null = chưa nhắc.
  remindedAt      DateTime?
  // Chỉ khách chưa có đơn nào (trừ đơn huỷ) dùng được; kiểm lại trong transaction đặt đơn (common/first-order.ts).
  newCustomerOnly Boolean            @default(false)
  // Lô mã in thẻ do admin sinh cùng cấu hình: gom số đã nhận/đã dùng và xuất lại CSV theo lô.
  batch           String?
  /// Cách dựng link QR của lô ({ page: 'home'|'scan', src?, card? }), cùng giá trị trên mọi mã của lô; null = lô tạo trước khi có cột (link `/?claim=`).
  batchLink       Json?
  claims          CouponClaim[]
  /// Người tạo / sửa gần nhất qua trang quản trị (null = mã hệ thống hoặc tạo trước khi có cột). Nhân viên chỉ sửa được
  /// mã do nhân viên tạo và không dùng được mã do chính mình tạo.
  createdById     String?
  updatedById     String?
  createdAt       DateTime           @default(now())

  @@index([batch])
  @@index([createdById, createdAt])
  @@map("coupons")
}

/// Khách đã nhận mã CLAIM vào ví. Mỗi khách nhận một mã một lần; số dòng của một mã không vượt `usageLimit`.
model CouponClaim {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  claimedAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
  @@map("coupon_claims")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  userId     String
  orderId    String?
  redeemedAt DateTime @default(now())

  // B4: idempotency cho retry — 1 đơn chỉ được ghi 1 redemption cho 1 coupon.
  @@unique([couponId, orderId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ============================================================
// 4.5 Affiliate (CTV nội bộ)
// ============================================================

model AffiliateLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  shortCode   String   @unique
  targetType  String
  targetId    String?
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("affiliate_links")
}

/// @deprecated Chỉ ghi, không đọc (C-108): AffiliateService.trackClick ghi mỗi lượt bấm, không nơi nào đọc lại.
/// Route công khai POST /affiliate/click chặn ghi trùng bằng ràng buộc duy nhất (shortCode, ipHash, dedupeDay): lần ghi thứ hai
/// trong ngày vi phạm khoá và bị bỏ, không có truy vấn đọc nào.
model AffiliateClick {
  id               String   @id @default(cuid())
  shortCode        String
  visitorId        String
  ipHash           String
  userAgent        String?
  referrer         String?
  clickedAt        DateTime @default(now())
  /// @deprecated Không nơi nào ghi hoặc đọc (C-108, A7-24).
  convertedOrderId String?
  /// Ngày giờ VN (YYYY-MM-DD) của lượt bấm từ route công khai; null ở các dòng ghi bằng đường khác (Postgres cho phép nhiều null).
  dedupeDay        String?

  @@unique([shortCode, ipHash, dedupeDay])
  @@index([shortCode])
  @@map("affiliate_clicks")
}

enum CommissionStatus {
  PENDING
  LOCKED
  APPROVED
  PAID
  REJECTED
}

enum StorefrontType {
  CTV
  BRAND
  MERCHANT
}

enum ProductApprovalStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

enum CollectionKind {
  NORMAL
  COMBO
}

enum CollectionLayout {
  GRID
  CAROUSEL
  STACK
}

model Commission {
  id                  String           @id @default(cuid())
  affiliateUserId     String
  user                User             @relation(fields: [affiliateUserId], references: [id])
  orderId             String
  order               Order            @relation(fields: [orderId], references: [id])
  orderTotal          Int
  // Nền doanh số CTV cho bậc/mốc thưởng tháng: tổng item.total của các dòng CÓ hưởng hoa hồng
  // (rate > 0) — loại hàng affiliateBlocked, hàng rate 0 và phí ship (mirror cách tính amount).
  commissionableTotal Int              @default(0)
  rate                Decimal
  amount              Int
  /// Hoa hồng từng dòng lúc tạo { orderItemId: đồng } — trả một phần cắt đúng dòng trả theo mức % của dòng đó.
  /// Null ở hoa hồng tạo trước khi có cột này.
  lineAmounts         Json?
  status              CommissionStatus @default(PENDING)
  lockedAt            DateTime? // thời điểm đơn DELIVERED, bắt đầu đếm hold
  approvedAt          DateTime?
  paidAt              DateTime?
  payoutBatchId       String?
  createdAt           DateTime         @default(now())

  // Khoá idempotency tạo hoa hồng (createCommissionForOrder: INSERT ... ON CONFLICT DO NOTHING).
  @@unique([orderId, affiliateUserId])
  @@index([affiliateUserId, status])
  // lockCommissionsForOrder/reverseCommissionsForOrder (affiliate.service.ts) updateMany theo
  // orderId trên mỗi chuyển trạng thái đơn — không có index riêng cho orderId trước đây.
  @@index([orderId])
  // Cron duyệt hoa hồng hết hold (approveDueCommissions): status = LOCKED AND lockedAt <= mốc.
  @@index([status, lockedAt])
  @@map("commissions")
}

// Thưởng mốc doanh số tháng CTV đã nhận (AffiliateService.claimMilestone). Xu cộng qua
// CoinsService.grantCoins (coinsBalance + CoinTransaction refType AFFILIATE_MILESTONE, refId=id).
// @@unique(userId, milestoneId, monthKey) là khoá idempotency: 2 request claim đồng thời → request
// thua ăn P2002 trên insert → rollback cả tx cấp xu → không bao giờ cộng 2 lần.
model CtvMilestoneClaim {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  milestoneId  String // id trong CTV_MONTHLY_MILESTONES (vd 'milestone-3m')
  monthKey     String // 'YYYY-MM' theo giờ VN
  rewardXu     Int
  rewardPoints Int      @default(0) // PD-3: thưởng mốc bằng Điểm Xanh (lượt L2 ghi)
  revenue      BigInt // doanh số đã chốt tại lúc nhận (đối soát)
  createdAt    DateTime @default(now())

  @@unique([userId, milestoneId, monthKey])
  @@map("ctv_milestone_claims")
}

// Hoàn tiền đơn CTV lên hộ (placedForCustomer): tiền là của khách cuối, KHÔNG BAO GIỜ về ví CTV
// (C-001 / Q-01). Khách cuối có tài khoản (khớp SĐT) → cộng ví khách, dòng COMPLETED ngay để giữ vết;
// không có → PENDING chờ admin chuyển khoản lại tay. orderId unique: mỗi đơn hoàn tối đa một lần.
enum CustomerRefundMethod {
  WALLET
  MANUAL_TRANSFER
}

/// PROCESSING: admin đã bấm "Đang chuyển khoản" — nơi nhận bị khoá (khách không đổi sang Ví được nữa) cho tới khi
/// admin xác nhận đã chuyển (COMPLETED) hoặc trả lại hàng chờ (PENDING).
/// UNVERIFIED: tín hiệu chưa xác thực (Pancake báo khách trả dư) — khách không thấy, không chọn nơi nhận được; admin đối
/// chiếu sao kê rồi xác nhận (PENDING, báo khách) hoặc bỏ qua (DISMISSED: không nợ khách, giữ lại để Pancake báo lại cùng
/// số không tạo khoản mới).
enum CustomerRefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  UNVERIFIED
  DISMISSED
}

/// Vì sao Tubu nợ khách khoản này (D2). END_CUSTOMER: đơn CTV lên hộ, hoàn cho khách cuối (C-001).
/// CANCEL / RETURN: khách huỷ hoặc trả hàng đơn trả trước và chọn nhận về tài khoản ngân hàng.
/// LATE_PAYMENT: tiền chuyển khoản / ZaloPay về sau khi đơn đã huỷ hoặc hết hạn.
enum CustomerRefundKind {
  END_CUSTOMER
  CANCEL
  RETURN
  LATE_PAYMENT
  OVERPAYMENT
}

/// Hàng đợi hoàn tiền thủ công của admin. Dòng MANUAL_TRANSFER PENDING là tiền Tubu đang nợ khách; WALLET là
/// dòng vết của khoản đã vào Ví. Một đơn có thể có nhiều khoản (trả hàng nhiều lần, tiền về muộn sau khi huỷ).
model OrderCustomerRefund {
  id              String               @id @default(cuid())
  orderId         String
  order           Order                @relation(fields: [orderId], references: [id])
  orderCode       String
  kind            CustomerRefundKind   @default(END_CUSTOMER)
  /// Khoá chống tạo trùng trong cùng (đơn, loại): id yêu cầu trả hàng (RETURN), kênh + mã giao dịch
  /// (LATE_PAYMENT, OVERPAYMENT), rỗng cho loại chỉ có một lần mỗi đơn (END_CUSTOMER, CANCEL).
  refKey          String               @default("")
  /// Chủ đơn — khách thấy khoản này ở chi tiết đơn và tự chọn nơi nhận. Null với mọi khoản của đơn CTV lên hộ
  /// (END_CUSTOMER, và trả hàng / tiền về muộn / trả dư của đơn đó): tiền là của khách cuối, CTV không thấy và
  /// không chọn nơi nhận; SĐT + tên người nhận nằm ở phone / recipientName.
  userId          String?
  amount          Int
  phone           String? // SĐT khách cuối dạng nội địa 0xxxxxxxxx (endCustomerKey / snapshot)
  recipientName   String?
  customerUserId  String? // tài khoản nhận tiền khi method = WALLET
  method          CustomerRefundMethod
  status          CustomerRefundStatus
  reason          String // CANCELLED | RETURNED — trạng thái đơn gây ra lần hoàn
  /// Tài khoản nhận (MANUAL_TRANSFER). Trống = đang chờ khách chọn nơi nhận / nhập tài khoản.
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  completedAt     DateTime?
  completedBy     String? // adminId xác nhận đã chuyển khoản (MANUAL_TRANSFER)
  claimedBy       String? // adminId đang chuyển khoản (PROCESSING)
  claimedAt       DateTime?
  bankRef         String?
  adminNote       String?
  createdAt       DateTime             @default(now())

  @@unique([orderId, kind, refKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("order_customer_refunds")
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

model Payout {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  amount          Int // số thực nhận (đã trừ phí và thuế khấu trừ)
  fee             Int          @default(0) // phí chuyển khoản ngân hàng
  /// Tổng hoa hồng của lệnh trước khấu trừ thuế TNCN. NULL = lệnh cũ trước khi có khấu trừ (amount là toàn bộ).
  grossAmount     Int?
  /// Thuế TNCN đã khấu trừ tại nguồn (affiliate.pit_withhold_pct trên tổng grossAmount các lệnh trong tháng VN khi tổng ≥ affiliate.pit_withhold_threshold; mỗi lệnh chỉ giữ phần chênh so với số đã khấu trừ trước đó trong tháng).
  taxWithheld     Int          @default(0)
  /// Phần thuế đã giữ dư được hoàn vào Ví Tubu khi lệnh khác cùng tháng bị từ chối (lệnh đã duyệt/đã chi không sửa được taxWithheld nên ghi riêng). Thuế thực giữ = taxWithheld − taxRefunded.
  taxRefunded     Int          @default(0)
  /// MST/CCCD của người nhận lúc khấu trừ (chứng từ khấu trừ, báo cáo tháng giữ đúng số đã kê khai dù sau đó CTV sửa).
  taxId           String?
  method          String
  bankInfo        Json?
  status          PayoutStatus @default(REQUESTED)
  idempotencyKey  String?      @unique // chống double-submit khi chuyển hoa hồng vào Ví (double-tap/retry timeout)
  requestedAt     DateTime     @default(now())
  paidAt          DateTime?
  // Hàng đợi xử lý admin (P0 A5-08=A6-05, 2026-09-27): duyệt/từ chối/đã trả — mirror
  // DealerRewardClaim (reviewedBy/reviewedAt/rejectionReason/paidBy/adminNote); bankRef riêng cho
  // payout (mã giao dịch ngân hàng lúc mark-paid).
  reviewedBy      String? // adminId duyệt (APPROVED) hoặc từ chối (REJECTED)
  reviewedAt      DateTime?
  rejectionReason String? // bắt buộc khi REJECTED — hiển thị lại cho CTV
  paidBy          String? // adminId xác nhận đã chuyển khoản (mark-paid)
  bankRef         String? // mã giao dịch ngân hàng khi mark-paid
  adminNote       String?

  @@index([userId])
  @@map("payouts")
}

enum MerchantPayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum MerchantPayoutLineKind {
  SALE
  REVERSAL
}

/// Bản sửa tên/mô tả/ảnh của sản phẩm đối tác ĐANG BÁN, chờ admin duyệt (R3-MERCHANT-4). Nội dung trên `products` giữ nguyên
/// cho tới khi duyệt nên trang sản phẩm, giỏ và liên kết Pancake không gián đoạn; duyệt thì ghi đè lên sản phẩm, từ chối thì xoá
/// dòng. Mỗi sản phẩm tối đa một dòng (đối tác sửa tiếp thì dòng được cập nhật, không thêm). Là bản chụp đủ cả năm trường.
model ProductEditDraft {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  description String   @db.Text
  shortDesc   String?
  images      String[]
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@map("product_edit_drafts")
}

/// "Tubu giao hộ" (D4): một lần chuyển biến thể Pancake từ sản phẩm gốc sang sản phẩm đối tác. `unlinkedAt` NULL = đang
/// liên kết (mỗi biến thể tối đa một dòng như vậy — unique index có điều kiện trong migration). Gỡ liên kết trả biến thể về
/// sản phẩm gốc; khoảng [linkedAt, unlinkedAt) là các đơn của biến thể đó gian hàng được xem.
model MerchantPancakeLink {
  id                     String    @id @default(cuid())
  productId              String
  product                Product   @relation("PancakeLinkProduct", fields: [productId], references: [id])
  storefrontId           String
  variationId            String
  variation              Variation @relation(fields: [variationId], references: [id])
  /// NULL = liên kết có từ trước khi lưu lịch sử, không rõ sản phẩm gốc.
  originProductId        String?
  originProduct          Product?  @relation("PancakeLinkOrigin", fields: [originProductId], references: [id])
  /// Lần liên kết làm sản phẩm gốc hết biến thể nên bị tắt: gỡ liên kết thì bật lại.
  originDeactivated      Boolean   @default(false)
  /// Sản phẩm gốc đang bán lúc liên kết: admin đã xác nhận chuyển nó sang gian hàng.
  takeover               Boolean   @default(false)
  linkedAt               DateTime  @default(now())
  linkedBy               String?
  unlinkedAt             DateTime?
  unlinkedBy             String?
  unlinkReason           String?
  /// Tồn kho Tubu của biến thể lúc liên kết — hàng Tubu đã sở hữu; admin xem khi xác nhận hàng ký gửi (liên kết takeover).
  stockAtLink            Int?
  /// Liên kết takeover chỉ đối soát tự động sau khi admin xác nhận hàng đang bán là hàng ký gửi của gian hàng; đơn đặt từ
  /// mốc này mới tính. NULL với takeover = chưa đối soát; liên kết thường tính từ linkedAt.
  consignmentConfirmedAt DateTime?
  consignmentConfirmedBy String?
  /// % hoa hồng CTV (Variation.affiliateRate) lúc liên kết: liên kết xoá % này (hàng đối tác không ăn % của hàng Tubu), gỡ liên
  /// kết khôi phục đúng giá trị, kể cả NULL và 0. `affiliateRateCaptured` false = liên kết có từ trước cột này, gỡ thì không đụng %.
  affiliateRateAtLink    Decimal?
  affiliateRateCaptured  Boolean   @default(false)

  @@index([productId])
  @@index([storefrontId])
  @@index([variationId])
  @@index([originProductId])
  @@map("merchant_pancake_links")
}

/// Phiếu đối soát đơn đối tác tự giao (docs/2026-10-14-merchant-fulfilment-design.md mục 7). amount > 0: Tubu chuyển cho
/// đối tác; amount < 0: đối tác nộp lại Tubu (phí sàn trên đơn COD đối tác đã tự thu).
model MerchantPayout {
  id             String               @id @default(cuid())
  storefrontId   String
  storefront     Storefront           @relation(fields: [storefrontId], references: [id])
  amount         Int
  status         MerchantPayoutStatus @default(PENDING)
  /// Ảnh chụp tài khoản nhận lúc lập phiếu — đối tác đổi TK sau đó không đổi phiếu đã lập.
  bankInfo       Json?
  createdBy      String
  createdAt      DateTime             @default(now())
  paidAt         DateTime?
  paidBy         String?
  bankRef        String?
  /// Ghi chú admin nhập lúc lập phiếu; huỷ phiếu không đè lên đây (lý do huỷ có cột riêng).
  note           String?
  cancelledAt    DateTime?
  /// Admin huỷ phiếu.
  cancelledBy    String?
  /// Lý do huỷ gửi cho gian hàng.
  cancelReason   String?
  /// Ảnh chụp các dòng lúc huỷ: dòng thật bị xoá để đơn quay lại bảng kê (unique (orderId, kind, refKey)), nên phiếu đã huỷ
  /// vẫn xem lại được gồm những gì. `{ lineCount, orderCount, lines: [...] }`.
  cancelSnapshot Json?
  lines          MerchantPayoutLine[]

  @@index([storefrontId, createdAt])
  @@index([status, createdAt])
  @@map("merchant_payouts")
}

/// Một đơn chỉ được đối soát một lần (SALE) và trừ ngược một lần (REVERSAL): unique (orderId, kind).
model MerchantPayoutLine {
  id               String                 @id @default(cuid())
  payoutId         String
  payout           MerchantPayout         @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order                  @relation(fields: [orderId], references: [id])
  orderCode        String
  kind             MerchantPayoutLineKind
  goodsAmount      Int
  shippingFee      Int
  commissionAmount Int
  codCollected     Int
  netAmount        Int
  /// Phí vận hành "Tubu giao hộ" của dòng (phần % cộng phần cố định của đơn); 0 với đơn gian hàng tự giao.
  opsFeeAmount     Int                    @default(0)
  /// Dòng hàng "Tubu giao hộ" (đơn kho Tubu giao qua Pancake) mà dòng đối soát này thuộc về; NULL = đơn gian hàng tự giao.
  orderItemId      String?
  orderItem        OrderItem?             @relation(fields: [orderItemId], references: [id])
  /// Khoá dòng trong đơn: '' = dòng của cả đơn (SALE, REVERSAL khi đơn RETURNED); `RETURN:<id yêu cầu trả>` = REVERSAL của
  /// một lần trả một phần (D3) trên đơn đã/đang đối soát. Hàng "Tubu giao hộ" khoá theo dòng hàng: `ITEM:<orderItemId>` (SALE,
  /// REVERSAL khi đơn RETURNED), `RETURN:<id yêu cầu trả>:ITEM:<orderItemId>` (trả một phần). Mỗi khoá một dòng duy nhất trên
  /// mọi phiếu.
  refKey           String                 @default("")
  /// Số đơn vị của dòng hàng giao hộ mà dòng đảo này trả lại (trả một phần hoặc phần còn lại khi đơn bị trả); NULL = dòng SALE,
  /// dòng đơn tự giao, hoặc dòng đảo lập trước khi có cột này.
  units            Int?
  createdAt        DateTime               @default(now())

  @@unique([orderId, kind, refKey])
  @@index([payoutId])
  @@index([orderItemId])
  @@map("merchant_payout_lines")
}

/// Lịch sử phí sàn / phí "Tubu giao hộ" của gian hàng: mỗi lần admin sửa thêm một dòng. Khoản giao hộ lấy mức của dòng mới
/// nhất có effectiveFrom <= lúc đặt đơn (giống đơn tự giao chốt merchantCommissionPct lúc đặt).
model StorefrontTermsHistory {
  id                  String     @id @default(cuid())
  storefrontId        String
  storefront          Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  /// Phí sàn đã quy ra số (gian hàng theo merchant.commission_pct thì lưu mặc định lúc ghi; đổi mặc định ghi thêm dòng).
  /// NULL chỉ còn ở dòng cũ chưa quy ra — nơi đọc coi là mặc định hiện tại.
  commissionPct       Decimal?   @db.Decimal(5, 4)
  consignmentFeePct   Decimal    @db.Decimal(5, 4)
  consignmentFeeFixed Int
  effectiveFrom       DateTime   @default(now())
  /// NULL = dòng gốc (mức có trước khi lưu lịch sử).
  changedById         String?

  @@index([storefrontId, effectiveFrom])
  @@map("storefront_terms_history")
}

/// Subdomain/tên miền vừa bị gian hàng nhả: gian hàng KHÁC chỉ dùng lại sau thời gian chờ (SELLER-5) — link cũ khách lưu
/// không trỏ ngay sang gian hàng của người khác.
model ReleasedStorefrontIdentifier {
  value        String   @id
  storefrontId String
  releasedAt   DateTime @default(now())

  @@map("released_storefront_identifiers")
}

// ============================================================
// 4.6 Cashback (sàn ngoài qua Accesstrade)
// ============================================================

model CashbackMerchant {
  id               String          @id @default(cuid())
  slug             String          @unique
  provider         String          @default("accesstrade")
  name             String
  logoUrl          String
  category         String
  baseRate         Decimal
  fullRate         Decimal
  isActive         Boolean         @default(true)
  deeplinkTemplate String
  terms            String?
  clicks           CashbackClick[]

  @@map("cashback_merchants")
}

model CashbackClick {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  merchantId     String
  merchant       CashbackMerchant @relation(fields: [merchantId], references: [id])
  utmTraceId     String           @unique
  destinationUrl String
  productUrl     String?
  clickedAt      DateTime         @default(now())
  ip             String?

  @@index([userId])
  @@map("cashback_clicks")
}

enum CashbackStatus {
  PENDING
  CONFIRMED
  REJECTED
  PAID
}

model CashbackTransaction {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  clickId         String?
  provider        String         @default("accesstrade")
  merchantOrderId String
  orderAmount     Int
  commission      Int
  userReward      Int
  status          CashbackStatus @default(PENDING)
  postbackPayload Json
  confirmedAt     DateTime?
  paidAt          DateTime?

  @@unique([provider, merchantOrderId])
  @@index([userId, status])
  // Cron settle hoàn tiền hết hold: status = CONFIRMED AND confirmedAt <= mốc.
  @@index([status, confirmedAt])
  @@map("cashback_transactions")
}

// ============================================================
// 4.7 Đại lý B2B
// ============================================================

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model DealerApplication {
  id                    String       @id @default(cuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id])
  businessName          String
  taxCode               String?
  ownerName             String
  phone                 String
  address               String
  cccdFrontUrl          String
  cccdBackUrl           String
  storeFrontUrl         String?
  monthlyVolumeEstimate Int?
  notes                 String?
  status                DealerStatus @default(PENDING)
  reviewedBy            String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime     @default(now())

  // Chống TOCTOU ở DealerService.apply() (findFirst rồi create không transaction, 2 request đăng
  // ký đại lý đồng thời có thể tạo 2 đơn PENDING trùng): partial unique index
  // "dealer_applications_pending_user_key" ON (userId) WHERE status='PENDING' — Prisma schema
  // KHÔNG hỗ trợ cú pháp @@unique có điều kiện WHERE nên index này được thêm bằng migration SQL
  // thủ công (xem migrations/*_dealer_application_pending_unique), không khai báo được @@unique
  // chuẩn ở đây.
  @@index([userId])
  @@map("dealer_applications")
}

model DealerTier {
  id             String  @id
  name           String
  minOrderVolume Int
  discountRules  Json
  creditLimit    Int     @default(0)
  paymentTerms   String?

  @@map("dealer_tiers")
}

/// Lịch sử sửa bậc đại lý (chiết khấu, hạn mức, điều kiện): ai đổi gì lúc nào. Không FK để dòng lịch sử sống lâu hơn bậc.
model DealerTierHistory {
  id        String   @id @default(cuid())
  tierId    String
  /// CREATE | UPDATE
  action    String
  /// Ảnh chụp trước khi sửa (null khi tạo): { name, minOrderVolume, discountPct, creditLimit, paymentTerms }.
  oldValue  Json?
  newValue  Json
  changedBy String
  changedAt DateTime @default(now())

  @@index([tierId, changedAt])
  @@index([changedAt])
  @@map("dealer_tier_history")
}

model DealerCreditLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  refType   String
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  // Chống double-pay ở DealerService.payoutQuarterlyBonuses() (findFirst rồi create không
  // transaction, 2 lần chạy cron/manual chồng nhau có thể trả thưởng trùng 1 quý): unique trên
  // (userId, refType, refId). Đã rà soát TOÀN BỘ nơi tạo DealerCreditLedger trong dealer.service.ts
  // (chỉ 3 chỗ, không có nơi nào khác trong repo) trước khi thêm — an toàn với dữ liệu hiện có:
  //  - refType='ORDER': refId=order.id (globally unique per row) → không bao giờ trùng hợp lệ.
  //  - refType='PAYMENT' (creditPayment): KHÔNG set refId → luôn NULL. Postgres coi mỗi NULL là
  //    giá trị riêng biệt trong UNIQUE constraint (không tự đụng nhau) → nhiều lần thanh toán công
  //    nợ của cùng 1 dealer vẫn tạo được nhiều dòng PAYMENT bình thường, KHÔNG bị chặn nhầm.
  //  - refType='QUARTER_BONUS': refId=quarter (vd "Q3/2026") — ĐÚNG cặp cần chặn trùng, 1 dealer
  //    chỉ nhận 1 dòng thưởng cho 1 quý.
  @@unique([userId, refType, refId])
  @@index([userId])
  @@map("dealer_credit_ledgers")
}

/// Bản chụp bảng bậc thưởng quý lúc tính thưởng quý đó lần đầu (khoá "Q3/2026", cùng refId của QUARTER_BONUS). Trả bù và thu hồi
/// của quý dùng bản này để admin đổi bậc cho quý mới không làm lệch quý cũ. Tạo một lần, không sửa.
model DealerQuarterBonusTier {
  quarter   String   @id
  tiers     Json
  createdAt DateTime @default(now())

  @@map("dealer_quarter_bonus_tiers")
}

// Lịch sử đổi giá đại lý theo bậc (back-office "admin Excel giá") — truy vết old→new, ai đổi.
model DealerPriceHistory {
  id          String    @id @default(cuid())
  variationId String
  variation   Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  sku         String
  tierId      String // bậc đại lý áp giá
  oldPrice    Int? // null = trước đó chưa có giá riêng cho bậc này
  newPrice    Int
  changedBy   String // adminId
  createdAt   DateTime  @default(now())

  @@index([variationId, createdAt])
  @@index([tierId])
  @@map("dealer_price_history")
}

/// Mẫu đơn đại lý lưu sẵn (#64) — đặt lại 1 chạm. items: [{variationId, quantity}].
model DealerOrderTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  items     Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("dealer_order_templates")
}

// ============================================================
// 4.8 Gamification — Vườn Xanh
// ============================================================

model GameProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  streakDays         Int       @default(0)
  longestStreak      Int       @default(0)
  lastCheckInAt      DateTime?
  treeStage          Int       @default(1)
  totalSeeds         Int       @default(0)
  ecoImpact          Json?
  badges             String[]  @default([])
  lastWateredAt      DateTime? // §6.7.3: tính héo (3 ngày)/chết (7 ngày)
  streakFreezes      Int       @default(0)
  lastDewAt          DateTime?
  brokenStreakDays   Int       @default(0) // §streak-repair: số ngày của chuỗi vừa bị mất, chờ hồi sinh
  brokenStreakAt     DateTime? // thời điểm mất chuỗi (cửa sổ hồi sinh 48h tính từ đây)
  lastStreakRepairAt DateTime? // lần hồi sinh gần nhất (cooldown 30 ngày)

  @@map("game_profiles")
}

// Cây thật cam kết trồng khi user thu hoạch cây ảo (§6.7.7 "Tác động xanh").
// status: PLEDGED (đã cam kết) → PLANTED (PanNature xác nhận trồng thật).
model PlantedTree {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificateCode String        @unique // mã chứng nhận hiển thị cho user
  treeType        String        @default("Cây Dứa Fuwa3e")
  region          String? // vùng trồng (khi PanNature xác nhận)
  status          PlantedStatus @default(PLEDGED)
  pledgedAt       DateTime      @default(now())
  plantedAt       DateTime? // thời điểm PanNature xác nhận trồng thật

  @@index([userId])
  @@map("planted_trees")
}

enum PlantedStatus {
  PLEDGED
  PLANTED
}

// Vườn Xanh 2.0 Phase 2 — mốc cộng đồng cây thật (mô hình Ant Forest gom batch).
// Hồ giọt nước toàn user; đủ targetDrops → Tubu cam kết trồng treesToPlant cây thật
// ở vùng có tên (PanNature gate). Fulfil có status-guard chống trồng batch 2 lần.
model CommunityGoal {
  id            String                  @id @default(cuid())
  title         String
  region        String // vùng trồng có tên (VD: "Rừng phòng hộ Cần Giờ")
  targetDrops   Int
  currentDrops  Int                     @default(0)
  treesToPlant  Int
  status        CommunityGoalStatus     @default(ACTIVE)
  startAt       DateTime                @default(now())
  endAt         DateTime?
  fulfilledAt   DateTime?
  contributions CommunityContribution[]

  @@index([status])
  @@map("community_goals")
}

model CommunityContribution {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      CommunityGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  drops     Int           @default(0)
  updatedAt DateTime      @updatedAt

  @@unique([userId, goalId])
  @@index([goalId])
  @@map("community_contributions")
}

enum CommunityGoalStatus {
  ACTIVE
  FULFILLING
  DONE
}

// Vườn Xanh 2.0 Phase 3 — sổ tay loài cây Việt Nam (chiều sâu + giáo dục sinh thái).
// Mỗi lần thu hoạch, user "sưu tập" 1 loài (weighted theo rarity). Mỗi loài kèm
// chuyện sinh thái + ecoFact để học. SpeciesCodex (FE) hiển thị lưới đã/chưa mở.
model PlantSpecies {
  id             String        @id
  name           String
  scientificName String?
  region         String?
  rarity         SpeciesRarity @default(COMMON)
  story          String? // chuyện về loài (sinh thái/văn hoá)
  ecoFact        String? // 1 sự thật sinh thái ngắn
  emoji          String        @default("🌳") // minh hoạ (chưa có imageUrl thật)
  imageUrl       String?
  collectedBy    UserSpecies[]

  @@map("plant_species")
}

model UserSpecies {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesId        String
  species          PlantSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  count            Int          @default(1)
  firstCollectedAt DateTime     @default(now())

  @@unique([userId, speciesId])
  @@index([userId])
  @@map("user_species")
}

enum SpeciesRarity {
  COMMON
  RARE
  LEGENDARY
}

// Vườn Xanh 2.0 Phase 4 — mùa/sự kiện. Mỗi mùa có chủ đề + vùng + loài nổi bật;
// khung thời gian startAt..endAt. BXH mùa = top người góp nước cho mốc cộng đồng
// đang mở (tính theo CommunityContribution).
model Season {
  id                 String   @id
  name               String
  theme              String?
  region             String?
  featuredSpeciesIds String[] @default([])
  startAt            DateTime
  endAt              DateTime

  @@index([startAt, endAt])
  @@map("seasons")
}

// Vườn Xanh — Season Pass (chặng mùa): ladder bậc tích XP theo điểm danh mỗi ngày.
// Mỗi bậc có phần thưởng free + premium (premium mở khi có gói đăng ký định kỳ ACTIVE).
// claimedFree/claimedPremium giữ chỉ số bậc đã nhận (chống nhận trùng, idempotent).
model UserSeasonPass {
  id             String   @id @default(cuid())
  userId         String
  seasonId       String
  xp             Int      @default(0)
  claimedFree    Int[]    @default([])
  claimedPremium Int[]    @default([])
  updatedAt      DateTime @updatedAt

  @@unique([userId, seasonId])
  @@map("user_season_passes")
}

// Vườn Xanh 2.0 (social) — tặng nước cho bạn bè trong mạng giới thiệu.
// unique [sender, recipient, dayKey] chống tặng 2 lần/ngày/người.
model WaterGift {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("GiftsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("GiftsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  amount      Int
  dayKey      String
  createdAt   DateTime @default(now())

  @@unique([senderId, recipientId, dayKey])
  @@index([recipientId])
  @@map("water_gifts")
}

// Vườn Xanh 2.0 — Lô đất / mở rộng vườn (§6.7). Lô nhà (slot 0) là cây trong GameProfile.
// User mở thêm lô phụ (slot 1..) bằng 💧/TubuXu; mỗi lô là 1 cây độc lập tưới & thu hoạch.
model GardenPlot {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot          Int // 1-based, slot 0 = lô nhà (không lưu ở đây)
  treeType      String    @default("Cây Dứa Fuwa3e")
  speciesId     String? // loài đang trồng (tuỳ chọn, liên kết PlantSpecies)
  progress      Int       @default(0)
  target        Int       @default(600)
  treeStage     Int       @default(1)
  treesPlanted  Int       @default(0)
  lastWateredAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, slot])
  @@index([userId])
  @@map("garden_plots")
}

// Chỉ còn cho bảng bottle_returns đã ngừng dùng (Refill đã gỡ). KHÔNG DROP.
enum RefillStatus {
  PENDING
  APPROVED
  REJECTED
}

// Refill / đổi vỏ chai (§6.14.6) — mỗi lần khách đổi vỏ chai rỗng lấy thưởng 💧.
/// @deprecated Refill đã gỡ (Đổi rác lấy quà thay thế, spec 13). Không còn code nào đọc hay ghi; bản cũ khi quay lại vẫn dùng bảng này nên KHÔNG DROP.
model BottleReturn {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity         Int // số vỏ chai đổi lần này; khi duyệt = số vỏ nhân viên THỰC NHẬN (≤ số khách khai)
  seedsAwarded     Int // 💧 đã thưởng (khi APPROVED)
  status           RefillStatus          @default(PENDING)
  createdAt        DateTime              @default(now())
  // Chỉ có khi nhân viên duyệt số vỏ ít hơn khách khai: số khách khai ban đầu, để đối soát.
  declaredQuantity Int?
  reviewedBy       String? // userId nhân viên/admin duyệt hoặc từ chối
  reviewedAt       DateTime?
  rejectionReason  String?
  // Idempotency-Key của POST /refill/return: bấm đúp / retry sau timeout trả lại đúng yêu cầu đã tạo thay vì tạo dòng thứ hai.
  // Unique theo (userId, key) nên khoá của người khác không đụng; dòng cũ không có key (NULL không trùng nhau).
  idempotencyKey   String?
  // Điểm nhận khách chọn lúc gửi để nhân viên biết vỏ sẽ về đâu. NULL ở dòng cũ và khi chưa có điểm nào cấu hình.
  pickupLocationId String?
  pickupLocation   RefillPickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
  @@map("bottle_returns")
}

/// @deprecated Refill đã gỡ (Đổi rác lấy quà thay thế, spec 13). Điểm nhận mới ở waste_points, không chép dữ liệu cũ sang. KHÔNG DROP.
/// Điểm nhận vỏ chai rỗng (admin quản lý ở tab Đổi vỏ chai). Thay cho ba khoá SystemConfig refill.pickup_*, các khoá đó
/// vẫn được đọc khi bảng chưa có dòng nào. Không xoá cứng: tắt isActive để giữ lịch sử các yêu cầu đã chọn điểm này.
model RefillPickupLocation {
  id            String         @id @default(cuid())
  name          String
  address       String
  hours         String?
  phone         String?
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bottleReturns BottleReturn[]

  @@index([isActive, sortOrder])
  @@map("refill_pickup_locations")
}

// Beta Tester (§6.14.11) — chương trình trải nghiệm sớm + kênh góp ý.
/// @deprecated Không còn code nào đọc hay ghi: 4 route /beta/* đã gỡ (Q-19). Có dữ liệu khách từ trước nên KHÔNG DROP.
model BetaTester {
  id       String     @id @default(cuid())
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   BetaStatus @default(ACTIVE)
  joinedAt DateTime   @default(now())

  @@map("beta_testers")
}

enum BetaStatus {
  ACTIVE
  LEFT
}

/// @deprecated Không còn code nào đọc hay ghi: 4 route /beta/* đã gỡ (Q-19) vì chương trình Beta Tester không có tác dụng.
/// Có dữ liệu khách từ trước nên KHÔNG DROP; dọn bằng migration riêng khi cần.
model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("beta_feedbacks")
}

// Community Feed (§6.14.12) — bảng tin cộng đồng Vườn Xanh.
// kind: MANUAL (user tự đăng) / HARVEST / MILESTONE / SPECIES (auto-post thành tích) /
// QUESTION / SHOWCASE / TIP (Cộng đồng Vườn Tubu Q&A — Pha 1a).
model FeedPost {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          FeedPostKind       @default(MANUAL)
  status        FeedPostStatus     @default(PUBLISHED)
  categoryId    String?
  category      CommunityCategory? @relation(fields: [categoryId], references: [id])
  title         String?
  body          String
  images        String[]
  meta          Json?
  isPinned      Boolean            @default(false)
  bestCommentId String?            @unique
  editedAt      DateTime?
  viewCount     Int                @default(0)
  // Bộ đếm tim phi chuẩn hoá chỉ để SẮP XẾP "Phổ biến" (khỏi đếm cả bảng feed_reactions mỗi lần
  // tải feed). Cập nhật cùng transaction với thả/bỏ tim; số hiển thị vẫn đếm thật theo trang.
  likeCount     Int                @default(0)
  createdAt     DateTime           @default(now())
  reactions     FeedReaction[]
  comments      FeedComment[]
  productTags   PostProductTag[]
  tags          PostTag[]

  @@index([status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([kind, status, createdAt])
  @@index([status, isPinned(sort: Desc), likeCount(sort: Desc), createdAt(sort: Desc)])
  @@map("feed_posts")
}

enum FeedPostKind {
  MANUAL
  HARVEST
  MILESTONE
  SPECIES
  QUESTION
  SHOWCASE
  TIP
}

enum FeedPostStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REMOVED
}

// Thả tim 💚 — mỗi user 1 tim/bài (unique chống đếm trùng).
model FeedReaction {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@map("feed_reactions")
}

model FeedComment {
  id         String   @id @default(cuid())
  postId     String
  post       FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  isAccepted Boolean  @default(false)
  // Ẩn mềm (tác giả tự xoá, hoặc admin gỡ khi bị báo cáo). Trước đây KHÔNG có đường nào
  // gỡ 1 bình luận: hub kiểm duyệt chỉ hiện nút ẩn cho targetType=POST vì backend không có
  // endpoint cho COMMENT → bình luận bị báo cáo vẫn hiển thị vĩnh viễn (P1-3,
  // docs/2026-09-08-review-progress.md). Giữ dòng để còn dấu vết kiểm duyệt, không xoá cứng.
  isRemoved  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([postId])
  @@map("feed_comments")
}

// Danh mục cộng đồng (Cộng đồng Vườn Tubu Pha 1a) — 6 danh mục cố định, seed idempotent.
model CommunityCategory {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  icon     String?
  order    Int        @default(0)
  isActive Boolean    @default(true)
  posts    FeedPost[]

  @@map("community_categories")
}

// Gắn thẻ sản phẩm vào bài viết cộng đồng (Q&A/Showcase) — dùng cho "hỏi mua gì" / khoe vườn.
model PostProductTag {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, productId])
  @@index([productId])
  @@map("post_product_tags")
}

// Báo cáo vi phạm bài viết/bình luận cộng đồng (Pha 2 — kiểm duyệt lai).
model CommunityReport {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("CommunityReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // POST | COMMENT
  targetId   String
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("community_reports")
}

// Hồ sơ uy tín cộng đồng — quyết định trust (bài PUBLISHED thẳng) vs PENDING (Pha 2).
model CommunityProfile {
  userId          String   @id
  user            User     @relation("CommunityProfile", fields: [userId], references: [id], onDelete: Cascade)
  reputation      Int      @default(0)
  level           Int      @default(1)
  isTrusted       Boolean  @default(false)
  isExpert        Boolean  @default(false)
  postCount       Int      @default(0)
  bestAnswerCount Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("community_profiles")
}

// Sổ cái điểm reputation cộng đồng. Trước đây bumpReputation chỉ increment thẳng vào
// CommunityProfile: không đếm được theo ngày (→ farm không trần: bình luận liên tục
// +2 rep/lần, lên top BXH trong vài phút), không idempotent (retry cộng 2 lần), và
// không đảo được khi bài bị xoá/gỡ (xoá bài vẫn giữ điểm). Mỗi dòng = 1 lần cộng/trừ,
// khoá theo (userId, reason, refId) nên retry/gọi lại không cộng lần 2.
// Xem P1-1 trong docs/2026-09-08-review-progress.md.
model ReputationEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("ReputationEvents", fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String // POST | ANSWER | BEST_ANSWER | REVERSE_POST ...
  refId     String // postId/commentId — nguồn phát sinh, để idempotent + đảo ngược
  createdAt DateTime @default(now())

  @@unique([userId, reason, refId])
  @@index([userId, createdAt])
  @@map("reputation_events")
}

// Thẻ tự do (hashtag) cho bài viết cộng đồng — dùng để tìm kiếm/lọc theo chủ đề (Pha 3).
model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  posts PostTag[]

  @@map("community_tags")
}

// Gắn thẻ tự do (Tag) vào bài viết — khác PostProductTag (gắn sản phẩm).
model PostTag {
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// Sự kiện cộng đồng (Pha 4 Task 2) — bài tham gia dùng FeedPost.meta.eventId (không cần
// bảng join riêng, MVP). status OPEN đang diễn ra; CLOSED khi admin chốt/chọn người thắng.
model CommunityEvent {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverUrl     String?
  startAt      DateTime
  endAt        DateTime
  rewardXu     Int      @default(0)
  // PD-3: thưởng bằng Điểm Xanh; migration A quy dòng cũ ceil(rewardXu/1000).
  rewardPoints Int      @default(0)
  status       String   @default("OPEN") // OPEN | CLOSED
  winnerUserId String?
  createdAt    DateTime @default(now())

  @@index([status, endAt])
  @@map("community_events")
}

// Mua chung / Group Buy (§6.14.8). Đủ targetSize người trước expiresAt → SUCCESS,
// mỗi thành viên nhận coupon = (basePrice − unitPrice) để mua với giá nhóm. Hết hạn → FAILED.
model GroupBuy {
  id               String           @id @default(cuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  initiatorId      String
  initiator        User             @relation("GroupBuysStarted", fields: [initiatorId], references: [id], onDelete: Cascade)
  targetSize       Int
  currentSize      Int              @default(0)
  unitPrice        Int // giá nhóm/đơn vị
  basePrice        Int // giá gốc lúc tạo (để tính phần giảm)
  status           GroupBuyStatus   @default(OPEN)
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  couponsGrantedAt DateTime? // đã phát đủ coupon cho mọi thành viên? null = chưa/còn sót → cron reconcile
  members          GroupBuyMember[]

  @@index([status, expiresAt])
  @@index([status, couponsGrantedAt]) // cron reconcile quét nhóm SUCCESS chưa phát đủ coupon
  @@index([productId])
  @@map("group_buys")
}

enum GroupBuyStatus {
  OPEN
  SUCCESS
  FAILED
}

model GroupBuyMember {
  id         String   @id @default(cuid())
  groupBuyId String
  groupBuy   GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([groupBuyId, userId])
  @@index([userId])
  @@map("group_buy_members")
}

// Yêu cầu đổi/trả (§6.4): chỉ lỗi NSX, window 7 ngày, admin duyệt → hoàn Ví +
// reverse điểm + reverse commission CTV.
/// Sổ ghi vết đổi trạng thái đơn hàng.
///
/// Trước đây đổi trạng thái chỉ để lại một dòng log ứng dụng (xoay vòng theo container) và một
/// chuỗi note nối thêm — không có actor. Một tài khoản admin bị chiếm chuyển 50 đơn đã giao
/// sang CANCELLED là mỗi đơn tự động hoàn tổng tiền vào ví khách, mà sau đó không truy được
/// admin nào thao tác đơn nào.
model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String
  toStatus   String
  /// ADMIN | CUSTOMER | MERCHANT | PANCAKE | SYSTEM
  actorType  String
  actorId    String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model ReturnRequest {
  id                      String              @id @default(cuid())
  orderId                 String
  userId                  String
  reason                  String
  /// DEFECTIVE | WRONG_ITEM | DAMAGED | EXPIRED | OTHER — null ở yêu cầu tạo trước khi trả theo dòng.
  reasonCode              String?
  images                  String[]            @default([])
  status                  ReturnStatus        @default(REQUESTED)
  refundMethod            String              @default("WALLET") // WALLET | BANK
  /// Tài khoản nhận khi refundMethod = BANK.
  bankName                String?
  bankAccountNo           String?
  bankAccountName         String?
  /// Lỗi do shop (hoàn cả phí ship dù chỉ trả một phần). Admin chốt lúc duyệt.
  shopFault               Boolean?
  /// Yêu cầu này trả nốt mọi dòng còn lại của đơn → đơn chuyển RETURNED.
  fullReturn              Boolean             @default(false)
  /// Phần đã hoàn khi duyệt (chốt một lần): tiền hàng sau phân bổ giảm giá/điểm, phí ship, Điểm Xanh đã dùng trả
  /// lại (tổng và phần lô quy đổi), Điểm Xanh tích bị thu hồi, hoa hồng CTV bị giảm. Các lần trả sau và lần đảo cả
  /// đơn trừ phần đã hoàn này để tổng không vượt đơn.
  refundAmount            Int?
  shippingRefund          Int                 @default(0)
  pointsRefunded          Int                 @default(0)
  convertedPointsRefunded Int                 @default(0)
  pointsReversed          Int                 @default(0)
  commissionReversed      Int                 @default(0)
  adminNote               String?
  reviewedBy              String?
  reviewedAt              DateTime?
  /// Admin bấm "Đã nhận hàng về" — chỉ lúc đó mới cộng lại tồn kho các dòng trả.
  receivedAt              DateTime?
  receivedBy              String?
  items                   ReturnRequestItem[]
  createdAt               DateTime            @default(now())

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@map("return_requests")
}

/// Dòng hàng và số lượng khách trả trong một yêu cầu (D3). refundAmount = phần tiền hàng của dòng, chốt khi duyệt.
model ReturnRequestItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  quantity        Int
  refundAmount    Int           @default(0)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_request_items")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// A1-03 (audit 2026-09): nút "Gửi yêu cầu xoá tài khoản" trong miniapp trước đây chỉ hiện snackbar
// giả, không gọi API nào — BE không có endpoint xoá tài khoản dù chính sách bảo mật hứa xoá được.
// Đây KHÔNG phải xoá thật (cascade/ẩn danh hoá dữ liệu là quyết định nghiệp vụ lớn hơn phạm vi vá
// lỗi này) — chỉ là một YÊU CẦU được ghi nhận thật + báo admin xử lý qua CSKH, mirror cấu trúc tối
// giản của ReturnRequest (không FK cứng, chỉ userId + index để admin truy vấn).
model AccountDeletionRequest {
  id                     String                       @id @default(cuid())
  userId                 String
  reason                 String?
  status                 AccountDeletionRequestStatus @default(PENDING)
  adminNote              String?
  reviewedBy             String?
  reviewedAt             DateTime?
  createdAt              DateTime                     @default(now())
  /// Số dư Ví Tubu (VND) khách đã thấy và đồng ý bỏ khi xoá tài khoản; chỉ có khi lúc gửi Ví còn tiền.
  walletForfeitAmount    Int?
  walletForfeitConsentAt DateTime?

  @@index([userId])
  @@index([status])
  @@map("account_deletion_requests")
}

enum AccountDeletionRequestStatus {
  PENDING
  RESOLVED
}

// Nhắc mua lại theo chu kỳ (§6.14.7 Lifecycle Reminder).
// Cron tính từ đơn DELIVERED cuối của (user × variation); remindedAt chống spam.
model ReorderReminder {
  id          String    @id @default(cuid())
  userId      String
  variationId String
  productName String
  lastOrderAt DateTime
  remindedAt  DateTime? // null/cũ hơn lastOrderAt = chưa nhắc cho chu kỳ này

  @@unique([userId, variationId])
  @@index([userId])
  @@map("reorder_reminders")
}

model GameSpin {
  id          String   @id @default(cuid())
  userId      String
  prizeId     String
  prizeName   String
  prizeValue  Int?
  rewardType  String
  rewardRefId String?
  spunAt      DateTime @default(now())

  @@index([userId])
  @@map("game_spins")
}

model GameQuiz {
  id          String  @id
  question    String
  options     Json
  correct     Int
  rewardPts   Int
  brand       String?
  category    String  @default("nature")
  difficulty  Int     @default(1)
  explanation String?
  waterReward Int     @default(8)

  @@map("game_quizzes")
}

model GameQuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  isCorrect   Boolean
  attemptedAt DateTime @default(now())
  // Ngày (UTC+7, "YYYY-MM-DD") lúc trả lời — khoá chặn trả lời trùng/ngày bằng unique index
  // DB-level (race-safe), thay cho check đọc-rồi-tạo (TOCTOU) trước đây trong answerQuiz().
  // Nullable: bản ghi cũ trước migration này giữ NULL, không bị chặn (Postgres coi mỗi NULL
  // là 1 giá trị riêng biệt trong unique index) — chỉ áp dụng cho các lần trả lời MỚI.
  dayKey      String?

  // @@unique([userId, quizId, dayKey]) đã phủ mọi query lọc theo userId (leftmost prefix) —
  // @@index([userId]) cũ bị xoá (redundant, mỗi insert phải ghi thêm 1 btree index vô ích).
  @@unique([userId, quizId, dayKey])
  @@map("game_quiz_attempts")
}

model Mission {
  id           String  @id
  code         String  @unique
  title        String
  description  String
  rewardPoints Int
  rewardCoupon String?
  goal         Int     @default(1)
  isRepeatable Boolean @default(false)

  @@map("missions")
}

// A1-02 (audit 2026-09): trước migration này bảng tồn tại trong schema nhưng KHÔNG nơi nào đọc/ghi
// — thẻ nhiệm vụ Vườn Xanh hứa thưởng nhưng không có đường cộng. Giờ là khoá idempotency THẬT cho
// GameService.claimMission: 1 dòng = 1 (mission, chu kỳ) ĐÃ NHẬN. cycleKey phân biệt các lượt nhận
// lặp lại của nhiệm vụ isRepeatable (vd CHECKIN_7 mỗi 7 ngày streak mới) — nhiệm vụ không lặp lại
// dùng cycleKey cố định '0'. Unique thay cho @@index cũ: chặn double-claim dưới đồng thời bằng
// P2002 (insert-trước-cộng-thưởng), không phải check đọc-rồi-ghi (mirror CtvMilestoneClaim).
model MissionProgress {
  id          String    @id @default(cuid())
  userId      String
  missionId   String
  cycleKey    String    @default("0")
  progress    Int       @default(0)
  goal        Int
  completedAt DateTime?

  @@unique([userId, missionId, cycleKey])
  @@map("mission_progress")
}

// ============================================================
// 4.9 Đánh giá
// ============================================================

model Review {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  orderId      String
  rating       Int
  comment      String?
  images       String[]
  videoUrl     String? // review video (UGC §6.14.9)
  pointsEarned Int      @default(0)
  isVerified   Boolean  @default(true)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Một đánh giá cho mỗi lần mua (đơn) của sản phẩm. Thứ tự cột để các truy vấn theo (khách, sản phẩm) vẫn dùng tiền tố chỉ mục.
  @@unique([userId, productId, orderId])
  @@index([productId])
  @@map("reviews")
}

// ============================================================
// 4.10 Notification
// ============================================================

model NotificationTemplate {
  id             String  @id
  code           String  @unique
  channel        String
  zaloTemplateId String?
  bodyTemplate   String

  @@map("notification_templates")
}

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String
  templateCode String
  channel      String
  payload      Json
  status       String
  error        String?
  sentAt       DateTime @default(now())

  // Inbox (userId + channel ORDER BY sentAt DESC) và chống nhắc lặp theo user (userId + sentAt) —
  // prefix userId vẫn phục vụ mọi truy vấn chỉ lọc userId nên không giữ index [userId] riêng.
  @@index([userId, sentAt])
  // Cron nhắc theo mẫu trong N ngày gần nhất (game-reminder: templateCode + sentAt >= mốc).
  @@index([templateCode, sentAt])
  @@map("notification_logs")
}

// ============================================================
// 4.11 Webhook & Sync
// ============================================================

model PancakeWebhookEvent {
  id            String    @id @default(cuid())
  eventType     String
  /// eventType + sha256(payload chuẩn hoá thứ tự key) — Pancake gửi lại y hệt thì trùng key, không lưu/xử lý 2 lần.
  /// Null ở các dòng nhận trước khi có cột (không backfill: dòng trùng cũ sẽ vỡ unique).
  dedupeKey     String?   @unique
  rawPayload    Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  /// RECEIVED | PROCESSING | PROCESSED | FAILED | UNMATCHED | IGNORED (cố ý không áp, lý do ở `error`)
  status        String
  /// Số lần worker đã claim (tăng lúc claim, không phải lúc xong) — tiến trình chết giữa chừng vẫn bị tính.
  attempts      Int       @default(0)
  /// Mốc worker claim PROCESSING — quá hạn thì coi như worker đã chết, được claim lại.
  claimedAt     DateTime?
  error         String?
  /// Admin bấm "Đã xử lý" ở Sức khoẻ hệ thống: sự kiện lỗi/kẹt không còn tính vào báo động (chạy lại thì xoá mốc).
  dismissedAt   DateTime?
  dismissedById String?

  @@index([status, receivedAt])
  @@map("pancake_webhook_events")
}

/// Webhook Gomdon (vận đơn đổi hàng thu gom tái chế) — lưu MỌI lần gọi đã qua xác thực để
/// audit/replay; xử lý async qua queue gomdon-events (retry) + cron cứu hộ event kẹt.
model GomdonWebhookEvent {
  id            String    @id @default(cuid())
  /// order_id|order_code|order_customer_id + status + created_time — Gomdon gửi lại cùng sự kiện
  /// thì trùng key → không xử lý 2 lần.
  dedupeKey     String    @unique
  gomdonOrderId String?
  orderCode     String?
  gomdonStatus  Int?
  eventTime     DateTime?
  rawPayload    Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  /// RECEIVED | PROCESSED | IGNORED | FAILED
  status        String
  attempts      Int       @default(0)
  error         String?
  orderId       String?
  /// Admin bấm "Đã xử lý" ở Sức khoẻ hệ thống: sự kiện lỗi không còn tính vào báo động (chạy lại thì xoá mốc).
  dismissedAt   DateTime?
  dismissedById String?

  @@index([status, receivedAt])
  @@index([gomdonOrderId])
  @@map("gomdon_webhook_events")
}

// ============================================================
// 15. SystemConfig — Single source of truth cho tham số nghiệp vụ
// ============================================================

/// Báo động vận hành Gomdon (vận đơn trùng, huỷ không được, Gomdon báo giao/huỷ bất thường...). Lưu lại để web
/// admin thấy và giữ đơn trong hàng đợi "Cần xử lý thu gom" tới khi có người đánh dấu đã xử lý — thông báo in-app
/// chỉ tới tài khoản ADMIN trên mini app và không xem lại được từ web admin.
model GomdonAlert {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message      String
  /// Nhóm việc hệ thống tự đóng được khi tự xử lý xong (gomdon-alert.service.ts GOMDON_ALERT_KIND): WAYBILL_NEEDED
  /// (cần tạo/kiểm tra vận đơn tay), WAYBILL_NOTE (cần ghi mã vận đơn vào Pancake), CANCEL_NEEDED (cần huỷ tay vận
  /// đơn của đơn đã huỷ). Null = chỉ người đóng.
  kind         String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([orderId, resolvedAt])
  @@index([resolvedAt, createdAt])
  @@map("gomdon_alerts")
}

/// Trạng thái vận hành ghi bền (PLATFORM-5), mỗi việc một dòng: lượt đồng bộ catalog Pancake gần nhất (process nào
/// chạy cũng ghi, màn sức khoẻ đọc được dù request rơi vào instance khác) và trạng thái báo động sức khoẻ hệ thống
/// (đang báo những gì, báo lần cuối lúc nào) để cron 5 phút không báo lặp.
model OpsHealthState {
  key         String    @id
  lastOkAt    DateTime?
  lastErrorAt DateTime?
  lastError   String?
  detail      Json?
  alertSince  DateTime?
  alertedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("ops_health_states")
}

model SystemConfig {
