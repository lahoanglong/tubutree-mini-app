// Tubu Tree — Prisma schema v0 (Phase 0)
// Nguồn: TUBU_TREE_BUILD_SPEC_v1.1.md Section 4 (Data Model) + Section 15 (SystemConfig).
// Quy ước: tên bảng số nhiều tiếng Anh, cờ pancakeId để map về Pancake POS.
// Tiền tệ (VND) dùng Int (đủ cho giá trị VND thực tế); % dùng Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 4.1 User & quyền
// ============================================================

enum UserRole {
  CUSTOMER
  AFFILIATE
  DEALER
  STAFF
  ADMIN
}

model User {
  id                String   @id @default(cuid())
  zaloId            String?  @unique // openId từ Zalo
  zaloAccessToken   String? // mã hóa
  zaloRefreshToken  String? // mã hóa
  phone             String?  @unique
  email             String?
  fullName          String?
  dob               DateTime?
  avatarUrl         String?
  role              UserRole @default(CUSTOMER)
  tierId            String?
  tier              MembershipTier? @relation(fields: [tierId], references: [id])
  tierGraceUntil    DateTime? // §6.6: thời hạn ân hạn trước khi rớt hạng (null = không treo rớt)
  referralCode      String   @unique
  referredById      String?
  pointsBalance     Int      @default(0)
  walletBalance     Int      @default(0)
  coinsBalance      Int      @default(0) // TubuXu — tiền tệ tiêu trong app (không rút được)
  cashbackPending   Int      @default(0)
  isBlocked         Boolean  @default(false)
  pancakeCustomerId String?  @unique
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Quan hệ ngược
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  pointsTransactions  PointsTransaction[]
  coinTransactions    CoinTransaction[]
  affiliateLinks      AffiliateLink[]
  commissions         Commission[]
  storefronts         Storefront[]
  payouts             Payout[]
  cashbackClicks      CashbackClick[]
  cashbackTxns        CashbackTransaction[]
  dealerApplications  DealerApplication[]
  dealerTemplates     DealerOrderTemplate[]
  gameProfile         GameProfile?
  reviews             Review[]
  refreshTokens       RefreshToken[]
  plantedTrees        PlantedTree[]
  communityContributions CommunityContribution[]
  species             UserSpecies[]
  giftsSent           WaterGift[] @relation("GiftsSent")
  giftsReceived       WaterGift[] @relation("GiftsReceived")
  gardenPlots         GardenPlot[]
  feedPosts           FeedPost[]
  feedReactions       FeedReaction[]
  feedComments        FeedComment[]
  groupBuysStarted    GroupBuy[]     @relation("GroupBuysStarted")
  groupBuyMemberships GroupBuyMember[]
  bottleReturns       BottleReturn[]
  betaTester          BetaTester?
  betaFeedbacks       BetaFeedback[]

  @@index([referredById])
  @@map("users")
}

// Refresh token lưu hash (rotation). Phục vụ Zalo auth flow Phase 0.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model MembershipTier {
  id            String   @id
  name          String
  minPoints     Int
  minSpending   Int?
  discountPct   Decimal  @default(0)
  pointMultiplier Decimal @default(1)
  perks         Json
  badgeImageUrl String?
  sortOrder     Int      @default(0)
  users         User[]

  @@map("membership_tiers")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient    String
  phone        String
  province     String
  district     String
  ward         String
  street       String
  isDefault    Boolean @default(false)
  provinceCode String
  districtCode String
  wardCode     String

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// 4.2 Catalog (mirror từ Pancake)
// ============================================================

model Product {
  id             String   @id @default(cuid())
  pancakeId      String   @unique
  brand          String
  brandId         String?
  brandRef        Brand?   @relation(fields: [brandId], references: [id])
  affiliateBlocked Boolean @default(false)
  slug           String   @unique
  name           String
  description    String   @db.Text
  shortDesc      String?
  images         String[]
  thumbnail      String?
  categoryIds    String[]
  tags           String[]
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isCombo        Boolean  @default(false)
  ratingAvg      Float    @default(0) // denormalized từ reviews (cập nhật khi tạo review)
  reviewCount    Int      @default(0)
  basePrice      Int
  salePrice      Int?
  metaTitle      String?
  metaDesc       String?
  forSegment     String[]
  ingredients    Json?
  certifications String[]
  variations     Variation[]
  reviews        Review[]
  groupBuys      GroupBuy[]
  storefrontItems StorefrontItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([brand])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@map("products")
}

model Brand {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String     @unique
  logoUrl        String?
  coverUrl       String?
  tagline        String?
  story          String?    @db.Text
  storyImages    String[]
  origin         String?
  certifications Json?
  isVerified     Boolean    @default(false)
  isPublished    Boolean    @default(false)
  ownerUserId    String?
  followerCount  Int        @default(0)
  products       Product[]
  storefront     Storefront?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("brands")
}

model Storefront {
  id          String                 @id @default(cuid())
  type        StorefrontType
  slug        String                 @unique
  ownerUserId String?
  owner       User?                  @relation(fields: [ownerUserId], references: [id])
  brandId     String?                @unique
  brand       Brand?                 @relation(fields: [brandId], references: [id])
  title       String
  headerNote  String?
  avatarUrl   String?
  coverUrl    String?
  theme       String                 @default("leaf-orange")
  isPublished Boolean                @default(false)
  publishedAt DateTime?
  collections StorefrontCollection[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([ownerUserId])
  @@map("storefronts")
}

model StorefrontCollection {
  id               String           @id @default(cuid())
  storefrontId     String
  storefront       Storefront       @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  title            String
  kind             CollectionKind   @default(NORMAL)
  layout           CollectionLayout @default(CAROUSEL)
  sortOrder        Int              @default(0)
  comboDiscountPct Int?
  items            StorefrontItem[]

  @@index([storefrontId])
  @@map("storefront_collections")
}

model StorefrontItem {
  id           String               @id @default(cuid())
  collectionId String
  collection   StorefrontCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product              @relation(fields: [productId], references: [id])
  variationId  String?
  note         String?
  sortOrder    Int                  @default(0)
  isPinned     Boolean              @default(false)
  isHidden     Boolean              @default(false)

  @@index([collectionId])
  @@index([productId])
  @@map("storefront_items")
}

model Variation {
  id           String  @id @default(cuid())
  pancakeId    String  @unique
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String  @unique
  name         String
  attributes   Json
  retailPrice  Int
  salePrice    Int?
  dealerPrices Json? // {tier_silver: 200000, tier_gold: 190000}
  affiliateRate Decimal? // % hoa hồng CTV (import Excel) — spec 15.2 affiliate.product_rate_source
  stock        Int     @default(0)
  isActive     Boolean @default(true)
  weight       Int?

  cartItems    CartItem[]
  dealerPriceHistory DealerPriceHistory[]

  @@index([productId])
  @@map("variations")
}

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  parent    Category?  @relation("CatParent", fields: [parentId], references: [id])
  children  Category[] @relation("CatParent")
  name      String
  slug      String     @unique
  image     String?
  sortOrder Int        @default(0)

  @@map("categories")
}

// ============================================================
// 4.3 Giỏ hàng & đơn
// ============================================================

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  couponCode String?
  updatedAt  DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id          String    @id @default(cuid())
  cartId      String
  cart        Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variationId String
  variation   Variation @relation(fields: [variationId], references: [id])
  quantity    Int

  @@unique([cartId, variationId])
  @@map("cart_items")
}

enum OrderType {
  RETAIL
  DEALER
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPING
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  COD
  ZALOPAY
  VNPAY
  BANK_TRANSFER
  WALLET
  XU
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum InvoiceStatus {
  NOT_REQUESTED
  REQUESTED
  ISSUED
  FAILED
}

model Order {
  id              String        @id @default(cuid())
  code            String        @unique
  idempotencyKey  String?       @unique // chống double-submit place-order (§12.1)
  pancakeOrderId  String?       @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  type            OrderType
  status          OrderStatus
  subtotal        Int
  discount        Int           @default(0)
  shippingFee     Int           @default(0)
  total           Int
  pointsEarned    Int           @default(0)
  pointsUsed      Int           @default(0)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus
  paymentTxnId    String?
  shippingAddress Json
  shippingPartner String?
  shippingCode    String?
  shippingStatus  String?
  trackingLink    String?
  shippingHistory Json?
  invoiceRequest  Json?
  invoiceUrl      String?
  invoiceStatus   InvoiceStatus? @default(NOT_REQUESTED)
  referrerUserId  String?
  commission      Int           @default(0)
  couponCode      String?
  note            String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status])
  @@index([referrerUserId])
  @@map("orders")
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variationId   String
  productName   String
  variationName String
  unitPrice     Int
  quantity      Int
  total         Int

  @@index([orderId])
  @@map("order_items")
}

// ============================================================
// 4.4 Loyalty & Voucher
// ============================================================

model PointsTransaction {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  delta     Int
  reason    String
  refType   String?
  refId     String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("points_transactions")
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int // +thưởng/đổi-vào, -tiêu
  reason    String // CONVERT_FROM_WALLET | REFERRAL_CASHBACK:<id> | REFERRED_CASHBACK:<id> | ORDER_PAY:<code> | GAME_BUY_SEEDS | GAME_BUY_TREE:<cert>
  refType   String? // CONVERT | REFERRAL | ORDER | GAME | ADMIN
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("coin_transactions")
}

enum CouponType {
  PERCENT
  AMOUNT
  FREESHIP
}

enum CouponScope {
  PUBLIC
  TIER
  USER_GROUP
  BIRTHDAY
  INVITE
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  type         CouponType
  value        Int
  minOrder     Int?
  maxDiscount  Int?
  startAt      DateTime
  endAt        DateTime
  usageLimit   Int?
  usedCount    Int          @default(0) // B4: bộ đếm atomic dùng cho updateMany guard
  perUserLimit Int          @default(1)
  applyTo      Json?
  isStackable  Boolean      @default(false)
  scope        CouponScope
  scopeMeta    Json?
  redemptions  CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  userId     String
  orderId    String?
  redeemedAt DateTime @default(now())

  // B4: idempotency cho retry — 1 đơn chỉ được ghi 1 redemption cho 1 coupon.
  @@unique([couponId, orderId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ============================================================
// 4.5 Affiliate (CTV nội bộ)
// ============================================================

model AffiliateLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  shortCode   String   @unique
  targetType  String
  targetId    String?
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("affiliate_links")
}

model AffiliateClick {
  id               String   @id @default(cuid())
  shortCode        String
  visitorId        String
  ipHash           String
  userAgent        String?
  referrer         String?
  clickedAt        DateTime @default(now())
  convertedOrderId String?

  @@index([shortCode])
  @@map("affiliate_clicks")
}

enum CommissionStatus {
  PENDING
  LOCKED
  APPROVED
  PAID
  REJECTED
}

enum StorefrontType {
  CTV
  BRAND
}

enum CollectionKind {
  NORMAL
  COMBO
}

enum CollectionLayout {
  GRID
  CAROUSEL
  STACK
}

model Commission {
  id              String           @id @default(cuid())
  affiliateUserId String
  user            User             @relation(fields: [affiliateUserId], references: [id])
  orderId         String
  orderTotal      Int
  rate            Decimal
  amount          Int
  status          CommissionStatus @default(PENDING)
  lockedAt        DateTime? // thời điểm đơn DELIVERED, bắt đầu đếm hold
  approvedAt      DateTime?
  paidAt          DateTime?
  payoutBatchId   String?
  createdAt       DateTime         @default(now())

  @@index([affiliateUserId, status])
  @@map("commissions")
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

model Payout {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  amount         Int // số thực nhận (đã trừ phí)
  fee            Int          @default(0) // phí chuyển khoản ngân hàng
  method         String
  bankInfo       Json?
  status         PayoutStatus @default(REQUESTED)
  idempotencyKey String?      @unique // chống double-submit rút tiền (double-tap/retry timeout)
  requestedAt    DateTime     @default(now())
  paidAt         DateTime?

  @@index([userId])
  @@map("payouts")
}

// ============================================================
// 4.6 Cashback (sàn ngoài qua Accesstrade)
// ============================================================

model CashbackMerchant {
  id               String                @id @default(cuid())
  slug             String                @unique
  name             String
  logoUrl          String
  category         String
  baseRate         Decimal
  fullRate         Decimal
  isActive         Boolean               @default(true)
  deeplinkTemplate String
  terms            String?
  clicks           CashbackClick[]

  @@map("cashback_merchants")
}

model CashbackClick {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  merchantId     String
  merchant       CashbackMerchant @relation(fields: [merchantId], references: [id])
  utmTraceId     String           @unique
  destinationUrl String
  productUrl     String?
  clickedAt      DateTime         @default(now())
  ip             String?

  @@index([userId])
  @@map("cashback_clicks")
}

enum CashbackStatus {
  PENDING
  CONFIRMED
  REJECTED
  PAID
}

model CashbackTransaction {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  clickId         String?
  merchantOrderId String         @unique
  orderAmount     Int
  commission      Int
  userReward      Int
  status          CashbackStatus @default(PENDING)
  postbackPayload Json
  confirmedAt     DateTime?
  paidAt          DateTime?

  @@index([userId, status])
  @@map("cashback_transactions")
}

// ============================================================
// 4.7 Đại lý B2B
// ============================================================

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model DealerApplication {
  id                    String       @id @default(cuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id])
  businessName          String
  taxCode               String?
  ownerName             String
  phone                 String
  address               String
  cccdFrontUrl          String
  cccdBackUrl           String
  storeFrontUrl         String?
  monthlyVolumeEstimate Int?
  notes                 String?
  status                DealerStatus @default(PENDING)
  reviewedBy            String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime     @default(now())

  @@index([userId])
  @@map("dealer_applications")
}

model DealerTier {
  id             String  @id
  name           String
  minOrderVolume Int
  discountRules  Json
  creditLimit    Int     @default(0)
  paymentTerms   String?

  @@map("dealer_tiers")
}

model DealerCreditLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  refType   String
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("dealer_credit_ledgers")
}

// Lịch sử đổi giá đại lý theo bậc (back-office "admin Excel giá") — truy vết old→new, ai đổi.
model DealerPriceHistory {
  id          String   @id @default(cuid())
  variationId String
  variation   Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  sku         String
  tierId      String // bậc đại lý áp giá
  oldPrice    Int? // null = trước đó chưa có giá riêng cho bậc này
  newPrice    Int
  changedBy   String // adminId
  createdAt   DateTime @default(now())

  @@index([variationId, createdAt])
  @@index([tierId])
  @@map("dealer_price_history")
}

/// Mẫu đơn đại lý lưu sẵn (#64) — đặt lại 1 chạm. items: [{variationId, quantity}].
model DealerOrderTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  items     Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("dealer_order_templates")
}

// ============================================================
// 4.8 Gamification — Vườn Xanh
// ============================================================

model GameProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  streakDays    Int       @default(0)
  longestStreak Int       @default(0)
  lastCheckInAt DateTime?
  treeStage     Int       @default(1)
  totalSeeds    Int       @default(0)
  ecoImpact     Json?
  badges        String[]  @default([])
  lastWateredAt DateTime? // §6.7.3: tính héo (3 ngày)/chết (7 ngày)
  streakFreezes Int       @default(0)
  lastDewAt     DateTime?

  @@map("game_profiles")
}

// Cây thật cam kết trồng khi user thu hoạch cây ảo (§6.7.7 "Tác động xanh").
// status: PLEDGED (đã cam kết) → PLANTED (PanNature xác nhận trồng thật).
model PlantedTree {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificateCode String       @unique // mã chứng nhận hiển thị cho user
  treeType        String       @default("Cây Dứa Fuwa3e")
  region          String? // vùng trồng (khi PanNature xác nhận)
  status          PlantedStatus @default(PLEDGED)
  pledgedAt       DateTime     @default(now())
  plantedAt       DateTime? // thời điểm PanNature xác nhận trồng thật

  @@index([userId])
  @@map("planted_trees")
}

enum PlantedStatus {
  PLEDGED
  PLANTED
}

// Vườn Xanh 2.0 Phase 2 — mốc cộng đồng cây thật (mô hình Ant Forest gom batch).
// Hồ giọt nước toàn user; đủ targetDrops → Tubu cam kết trồng treesToPlant cây thật
// ở vùng có tên (PanNature gate). Fulfil có status-guard chống trồng batch 2 lần.
model CommunityGoal {
  id           String                  @id @default(cuid())
  title        String
  region       String // vùng trồng có tên (VD: "Rừng phòng hộ Cần Giờ")
  targetDrops  Int
  currentDrops Int                     @default(0)
  treesToPlant Int
  status       CommunityGoalStatus     @default(ACTIVE)
  startAt      DateTime                @default(now())
  endAt        DateTime?
  fulfilledAt  DateTime?
  contributions CommunityContribution[]

  @@index([status])
  @@map("community_goals")
}

model CommunityContribution {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      CommunityGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  drops     Int           @default(0)
  updatedAt DateTime      @updatedAt

  @@unique([userId, goalId])
  @@index([goalId])
  @@map("community_contributions")
}

enum CommunityGoalStatus {
  ACTIVE
  FULFILLING
  DONE
}

// Vườn Xanh 2.0 Phase 3 — sổ tay loài cây Việt Nam (chiều sâu + giáo dục sinh thái).
// Mỗi lần thu hoạch, user "sưu tập" 1 loài (weighted theo rarity). Mỗi loài kèm
// chuyện sinh thái + ecoFact để học. SpeciesCodex (FE) hiển thị lưới đã/chưa mở.
model PlantSpecies {
  id             String         @id
  name           String
  scientificName String?
  region         String?
  rarity         SpeciesRarity  @default(COMMON)
  story          String? // chuyện về loài (sinh thái/văn hoá)
  ecoFact        String? // 1 sự thật sinh thái ngắn
  emoji          String         @default("🌳") // minh hoạ (chưa có imageUrl thật)
  imageUrl       String?
  collectedBy    UserSpecies[]

  @@map("plant_species")
}

model UserSpecies {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesId        String
  species          PlantSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  count            Int          @default(1)
  firstCollectedAt DateTime     @default(now())

  @@unique([userId, speciesId])
  @@index([userId])
  @@map("user_species")
}

enum SpeciesRarity {
  COMMON
  RARE
  LEGENDARY
}

// Vườn Xanh 2.0 Phase 4 — mùa/sự kiện. Mỗi mùa có chủ đề + vùng + loài nổi bật;
// khung thời gian startAt..endAt. BXH mùa = top người góp nước cho mốc cộng đồng
// đang mở (tính theo CommunityContribution).
model Season {
  id                 String   @id
  name               String
  theme              String?
  region             String?
  featuredSpeciesIds String[] @default([])
  startAt            DateTime
  endAt              DateTime

  @@index([startAt, endAt])
  @@map("seasons")
}

// Vườn Xanh 2.0 (social) — tặng nước cho bạn bè trong mạng giới thiệu.
// unique [sender, recipient, dayKey] chống tặng 2 lần/ngày/người.
model WaterGift {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("GiftsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("GiftsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  amount      Int
  dayKey      String
  createdAt   DateTime @default(now())

  @@unique([senderId, recipientId, dayKey])
  @@index([recipientId])
  @@map("water_gifts")
}

// Vườn Xanh 2.0 — Lô đất / mở rộng vườn (§6.7). Lô nhà (slot 0) là cây trong GameProfile.
// User mở thêm lô phụ (slot 1..) bằng 💧/TubuXu; mỗi lô là 1 cây độc lập tưới & thu hoạch.
model GardenPlot {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot          Int // 1-based, slot 0 = lô nhà (không lưu ở đây)
  treeType      String    @default("Cây Dứa Fuwa3e")
  speciesId     String? // loài đang trồng (tuỳ chọn, liên kết PlantSpecies)
  progress      Int       @default(0)
  target        Int       @default(600)
  treeStage     Int       @default(1)
  treesPlanted  Int       @default(0)
  lastWateredAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, slot])
  @@index([userId])
  @@map("garden_plots")
}

// Refill / đổi vỏ chai (§6.14.6) — mỗi lần khách đổi vỏ chai rỗng lấy thưởng 💧.
model BottleReturn {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity     Int // số vỏ chai đổi lần này
  seedsAwarded Int // 💧 đã thưởng
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("bottle_returns")
}

// Beta Tester (§6.14.11) — chương trình trải nghiệm sớm + kênh góp ý.
model BetaTester {
  id       String     @id @default(cuid())
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   BetaStatus @default(ACTIVE)
  joinedAt DateTime   @default(now())

  @@map("beta_testers")
}

enum BetaStatus {
  ACTIVE
  LEFT
}

model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("beta_feedbacks")
}

// Community Feed (§6.14.12) — bảng tin cộng đồng Vườn Xanh.
// kind: MANUAL (user tự đăng) / HARVEST / MILESTONE / SPECIES (auto-post thành tích).
model FeedPost {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FeedPostKind   @default(MANUAL)
  body      String
  meta      Json?
  createdAt DateTime       @default(now())
  reactions FeedReaction[]
  comments  FeedComment[]

  @@index([createdAt])
  @@map("feed_posts")
}

enum FeedPostKind {
  MANUAL
  HARVEST
  MILESTONE
  SPECIES
}

// Thả tim 💚 — mỗi user 1 tim/bài (unique chống đếm trùng).
model FeedReaction {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@map("feed_reactions")
}

model FeedComment {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("feed_comments")
}

// Mua chung / Group Buy (§6.14.8). Đủ targetSize người trước expiresAt → SUCCESS,
// mỗi thành viên nhận coupon = (basePrice − unitPrice) để mua với giá nhóm. Hết hạn → FAILED.
model GroupBuy {
  id          String           @id @default(cuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  initiatorId String
  initiator   User             @relation("GroupBuysStarted", fields: [initiatorId], references: [id], onDelete: Cascade)
  targetSize  Int
  currentSize Int              @default(0)
  unitPrice   Int // giá nhóm/đơn vị
  basePrice   Int // giá gốc lúc tạo (để tính phần giảm)
  status      GroupBuyStatus   @default(OPEN)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  couponsGrantedAt DateTime? // đã phát đủ coupon cho mọi thành viên? null = chưa/còn sót → cron reconcile
  members     GroupBuyMember[]

  @@index([status, expiresAt])
  @@index([status, couponsGrantedAt]) // cron reconcile quét nhóm SUCCESS chưa phát đủ coupon
  @@index([productId])
  @@map("group_buys")
}

enum GroupBuyStatus {
  OPEN
  SUCCESS
  FAILED
}

model GroupBuyMember {
  id         String   @id @default(cuid())
  groupBuyId String
  groupBuy   GroupBuy @relation(fields: [groupBuyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([groupBuyId, userId])
  @@index([userId])
  @@map("group_buy_members")
}

// Yêu cầu đổi/trả (§6.4): chỉ lỗi NSX, window 7 ngày, admin duyệt → hoàn Ví +
// reverse điểm + reverse commission CTV.
model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String
  reason       String
  images       String[]     @default([])
  status       ReturnStatus @default(REQUESTED)
  refundMethod String       @default("WALLET") // WALLET | BANK
  adminNote    String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// Nhắc mua lại theo chu kỳ (§6.14.7 Lifecycle Reminder).
// Cron tính từ đơn DELIVERED cuối của (user × variation); remindedAt chống spam.
model ReorderReminder {
  id          String    @id @default(cuid())
  userId      String
  variationId String
  productName String
  lastOrderAt DateTime
  remindedAt  DateTime? // null/cũ hơn lastOrderAt = chưa nhắc cho chu kỳ này

  @@unique([userId, variationId])
  @@index([userId])
  @@map("reorder_reminders")
}

model GameSpin {
  id          String   @id @default(cuid())
  userId      String
  prizeId     String
  prizeName   String
  prizeValue  Int?
  rewardType  String
  rewardRefId String?
  spunAt      DateTime @default(now())

  @@index([userId])
  @@map("game_spins")
}

model GameQuiz {
  id          String  @id
  question    String
  options     Json
  correct     Int
  rewardPts   Int
  brand       String?
  category    String  @default("nature")
  difficulty  Int     @default(1)
  explanation String?
  waterReward Int     @default(8)

  @@map("game_quizzes")
}

model GameQuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  isCorrect   Boolean
  attemptedAt DateTime @default(now())

  @@index([userId])
  @@map("game_quiz_attempts")
}

model Mission {
  id           String  @id
  code         String  @unique
  title        String
  description  String
  rewardPoints Int
  rewardCoupon String?
  isRepeatable Boolean @default(false)

  @@map("missions")
}

model MissionProgress {
  id          String    @id @default(cuid())
  userId      String
  missionId   String
  progress    Int       @default(0)
  goal        Int
  completedAt DateTime?

  @@index([userId])
  @@map("mission_progress")
}

// ============================================================
// 4.9 Đánh giá
// ============================================================

model Review {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  orderId      String
  rating       Int
  comment      String?
  images       String[]
  videoUrl     String? // review video (UGC §6.14.9)
  pointsEarned Int      @default(0)
  isVerified   Boolean  @default(true)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ============================================================
// 4.10 Notification
// ============================================================

model NotificationTemplate {
  id             String  @id
  code           String  @unique
  channel        String
  zaloTemplateId String?
  bodyTemplate   String

  @@map("notification_templates")
}

model NotificationLog {
  id           String   @id @default(cuid())
  userId       String
  templateCode String
  channel      String
  payload      Json
  status       String
  error        String?
  sentAt       DateTime @default(now())

  @@index([userId])
  @@map("notification_logs")
}

// ============================================================
// 4.11 Webhook & Sync
// ============================================================

model PancakeWebhookEvent {
  id          String    @id @default(cuid())
  eventType   String
  rawPayload  Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  status      String
  attempts    Int       @default(0)
  error       String?

  @@map("pancake_webhook_events")
}

// ============================================================
// 15. SystemConfig — Single source of truth cho tham số nghiệp vụ
// ============================================================

model SystemConfig {
  key         String   @id
  value       Json
  description String?
  category    String
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([category])
  @@map("system_configs")
}

model SystemConfigHistory {
  id        String   @id @default(cuid())
  key       String
  oldValue  Json
  newValue  Json
  changedBy String
  changedAt DateTime @default(now())

  @@index([key])
  @@map("system_config_history")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  variationId   String
  quantity      Int      @default(1)
  intervalWeeks Int      // 4 / 6 / 8 / 10
  addressId     String
  status        String   @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED
  nextRunAt     DateTime
  lastOrderId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("subscriptions")
}
