/// Lease chọn MỘT instance API chạy @Cron (common/cron-leader). Nhiều instance (scale, chồng lúc deploy)
/// thì chỉ instance giữ lease còn hạn chạy cron; instance khác dừng mọi cron job tới khi lease hết hạn.
model CronLease {
  name      String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime

  @@map("cron_leases")
}

/// Một dòng cho mỗi @Cron (khoá = tên cron Nest hoặc Lớp.phươngThức): lần chạy gần nhất và chuỗi lỗi liên tiếp. Chỉ leader ghi.
model CronRun {
  job                 String    @id
  lastStartedAt       DateTime
  lastFinishedAt      DateTime
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  /// Tên lớp lỗi + dòng đầu thông điệp, cắt 300 ký tự; không stack, không dữ liệu request.
  lastError           String?
  consecutiveFailures Int       @default(0)
  lastDurationMs      Int
  /// Lần báo admin gần nhất của chuỗi lỗi hiện tại; xoá khi job chạy lại thành công và lần lỗi cuối đã hơn 1 giờ.
  lastAlertedAt       DateTime?
  /// OK | ERRORS (chạy xong nhưng có log error) | THREW (ném lỗi) | SKIPPED (chạy chồng/chưa cấu hình).
  lastOutcome         String    @default("OK")
  /// Số log error của lần chạy gần nhất.
  lastErrorCount      Int       @default(0)

  @@map("cron_runs")
}

/// Nguồn đơn Pancake không phải đơn đặt trong app: sàn (Shopee/Lazada/TikTok), chat/điện thoại, hoặc chưa biết.
enum ExternalOrderSource {
  MARKETPLACE
  CHAT
  UNKNOWN
}

/// Trạng thái đơn ngoài suy từ mã trạng thái Pancake (pancake-status.map): OPEN = chưa giao xong.
enum ExternalOrderStatus {
  OPEN
  DELIVERED
  RETURNING
  RETURNED
  CANCELLED
  PARTIAL_RETURN
  DELETED
}

enum ExternalClaimKind {
  SCAN
  PHONE
}

enum ExternalClaimState {
  PENDING
  REVIEW
  HELD_NO_MEMBER
  CREDITED
  VOIDED
  REVERSED
  LAPSED
}

/// Đơn Pancake không có trong bảng orders (đơn sàn, chat, điện thoại). Khoá theo id đơn Pancake; `lastPayload` là
/// bản mới nhất vì pancake_webhook_events bị data-retention xoá theo hạn. KHÔNG chứa quan hệ tới users: userId ở
/// bảng claim là chuỗi thường, đơn ngoài tồn tại độc lập với thành viên.
model ExternalOrder {
  id                 String               @id @default(cuid())
  pancakeOrderId     String               @unique
  source             ExternalOrderSource
  /// shopee | lazada | tiktok; null với CHAT/UNKNOWN.
  channel            String?
  /// `${order_sources}|${account}|${marketplace_id}` — bảng "nguồn đã thấy" của admin gom theo khoá này.
  sourceKey          String
  trackingCode       String?
  trackingCodes      String[]
  marketplaceOrderSn String?
  /// SĐT dạng 0xxxxxxxxx để ghép thành viên; không bao giờ trả thô qua API.
  phone              String?
  phoneLast3         String?
  goodsValue         Int?
  pancakeStatus      Int?
  status             ExternalOrderStatus  @default(OPEN)
  pancakeInsertedAt  DateTime?
  pancakeUpdatedAt   DateTime?
  deliveredAt        DateTime?
  closedAt           DateTime?
  lastPayload        Json
  firstSeenAt        DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  /// Giá trị `updatedAt` lúc cron tạo bù claim chat đã xét đơn này; đơn chưa đổi từ đó thì không xét lại (đặt bằng SQL để không đẩy updatedAt).
  chatCheckedAt      DateTime?
  claim              ExternalPointsClaim?

  // SQL tay (migration 20261019100000_external_orders): "external_orders_phone_idx" ON (phone) WHERE phone IS NOT NULL.
  @@index([trackingCode])
  @@index([trackingCodes], type: Gin)
  @@index([source, status])
  @@index([sourceKey])
  @@map("external_orders")
}

/// Điểm chờ của một đơn ngoài (bước 2/3, chưa ghi dòng nào ở bước 1). Chỉ khi tới hạn mới ghi ĐÚNG một dòng vào
/// points_transactions. Partial unique SQL: "external_points_claims_code_key" ON ("claimedCode") WHERE "claimedCode" IS NOT NULL.
model ExternalPointsClaim {
  id              String             @id @default(cuid())
  externalOrderId String             @unique
  externalOrder   ExternalOrder      @relation(fields: [externalOrderId], references: [id])
  userId          String?
  kind            ExternalClaimKind
  state           ExternalClaimState @default(PENDING)
  ratePct         Decimal            @db.Decimal(6, 4)
  multiplier      Decimal            @db.Decimal(6, 3)
  points          Int                @default(0)
  countsForTier   Boolean            @default(false)
  claimedCode     String?
  releaseAt       DateTime?
  holdUntil       DateTime?
  creditedAt      DateTime?
  pointsTxId      String?
  voidReason      String?
  reviewReason    String?
  decidedById     String?
  /// Claim PHONE: SĐT trên đơn LÚC TẠO claim. Liên kết và trần tháng theo SĐT dùng cột này, không dùng `external_orders.phone` (nhân viên sửa được).
  /// Xoá về null cùng luật retention với `external_orders.phone`.
  orderPhone      String?
  /// Claim PHONE: id nhân viên tạo đơn trên Pancake (payload `creator.id`), để áp trần điểm tự cộng theo người tạo.
  creatorRef      String?
  /// Claim PHONE: tiền hàng của đơn ở lần kiểm gần nhất (tạo, liên kết, duyệt); releaseClaim chuyển REVIEW khi tiền hàng hiện tại lớn hơn số này.
  /// Lúc cộng ghi lại đúng tiền hàng đã cộng, nên với claim CREDITED chi tiêu 12 tháng xét hạng dùng số này, sửa đơn về sau không làm hạng nhảy.
  /// Claim SCAN: chỉ ghi lúc duyệt (tiền hàng người kiểm đã thấy), không ghi lại lúc cộng; releaseClaim cộng đúng số điểm đã chốt khi tiền hàng không vượt số này.
  creditedGoodsValue Int?
  /// Ngày VN 'YYYY-MM-DD' lúc tạo claim, để đếm trần ngày.
  dayKey          String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([orderPhone])
  @@index([creatorRef, createdAt])
  @@index([state, releaseAt])
  @@index([state, holdUntil])
  @@index([userId, createdAt])
  @@index([userId, dayKey])
  @@map("external_points_claims")
}

/// Mỗi lần khách gửi mã đơn sàn (kể cả không tìm thấy), để giới hạn thử và để cron ghép lại.
/// Partial unique SQL: "external_claim_attempts_unmatched_key" ON ("code") WHERE "result" = 'UNMATCHED' AND "resolvedAt" IS NULL.
model ExternalClaimAttempt {
  id              String    @id @default(cuid())
  userId          String
  code            String
  /// MATCHED | UNMATCHED | REJECTED_*
  result          String
  externalOrderId String?
  dayKey          String
  resolvedAt      DateTime?
  resolvedById    String?
  note            String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([result, createdAt])
  @@map("external_claim_attempts")
}

/// Nhật ký CHỈ THÊM của claim đơn ngoài (không bao giờ sửa, trigger chặn UPDATE): mỗi thao tác tạo, gắn, duyệt, huỷ, mở lại, đảo,
/// giữ điểm và mọi bước tự động của cron/webhook ghi một dòng. Không có khoá ngoại để dòng còn lại khi claim hay khách bị xoá.
model ExternalClaimEvent {
  id           String   @id @default(cuid())
  claimId      String
  /// CLAIM_CREATED | ATTACH | APPROVE | VOID | VOID_REOPEN | REOPEN_CLAIM | REVERSE | KEEP_POINTS | CREDIT | AUTO_VOID | AUTO_REVERSE | TO_REVIEW | FLAG_PARTIAL | LINK_PHONE | HOLD_NO_MEMBER | LAPSE | PHONE_CHANGED
  action       String
  /// Người thao tác; null = hệ thống (cron, webhook) hoặc chính khách khi gửi mã (khi đó `actorId` = userIdAfter).
  actorId      String?
  fromState    String?
  toState      String?
  userIdBefore String?
  userIdAfter  String?
  note         String?
  /// Trạng thái đơn ngoài lúc ghi sự kiện (APPROVE/ATTACH dùng để biết quyết định có được đưa ra khi đơn đã hoàn một phần chưa).
  orderStatus  String?
  createdAt    DateTime @default(now())

  @@index([claimId, createdAt])
  @@map("external_claim_events")
}

