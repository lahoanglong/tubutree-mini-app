  pointId   String
  userId    String
  role      WastePointStaffRole @default(STAFF)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  point     WastePoint          @relation(fields: [pointId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([pointId, userId])
  @@index([userId, isActive])
  @@map("waste_point_staff")
}

// CHECK and partial unique indexes: migration 20261020000000_waste_exchange, section WASTE HAND-WRITTEN CONSTRAINTS
model WastePointUsage {
