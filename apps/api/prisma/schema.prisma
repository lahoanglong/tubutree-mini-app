// CHECK and partial unique indexes: migration 20261020000000_waste_exchange, section WASTE HAND-WRITTEN CONSTRAINTS
model WasteRequest {
  id                      String                @id @default(cuid())
  code                    String                @unique
  userId                  String
  method                  WasteMethod
  status                  WasteRequestStatus    @default(OPEN)
  pointId                 String
  orderId                 String?               @unique
  carrier                 String?
  trackingCode            String?
  trackingNorm            String?
  trackingConflict        Boolean               @default(false)
  estimatedPoints         Int
  estimatedDrops          Int                   @default(0)
  capDayKey               String
  capMonthKey             String
  expiresAt               DateTime?
  inTransitAt             DateTime?
  receivedAt              DateTime?
  completedAt             DateTime?
  closedAt                DateTime?
  closeReason             WasteCloseReason?
  confirmedByUserId       String?
  pointsAwarded           Int?
  dropsAwarded            Int?
  receivedWeightGrams     Int?
  carrierCostVnd          Int?
  rejectionReason         WasteRejectionReason?
  rejectionNote           String?               @db.VarChar(500)
  reversedAt              DateTime?
  reversedByUserId        String?
  reversalReason          String?
  reversalShortfallPoints Int?
  idempotencyKey          String
  consentAt               DateTime
  consentVersion          String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  lines                   WasteRequestLine[]
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  point                   WastePoint            @relation(fields: [pointId], references: [id], onDelete: Restrict)
  order                   Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([trackingNorm])
  @@index([userId, status])
  @@index([status, method])
  @@index([capMonthKey])
  @@index([confirmedByUserId, completedAt])
  @@index([pointId, status])
  @@index([status, expiresAt])
  @@map("waste_requests")
}

// CHECK and partial unique indexes: migration 20261020000000_waste_exchange, section WASTE HAND-WRITTEN CONSTRAINTS
