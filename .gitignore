.audit/

# 2026-10 review: ảnh chụp (~90MB) và log đo tải giữ local, không commit
docs/2026-10-review/screens/
scripts/loadtest/results/
scripts/uiux/results/
scripts/uiux/.probe/

# Dấu vết lần deploy ghi ở gốc repo trên máy chủ (runbook mục 1.0, mục 5 bước 2 và 6, deploy.yml). Không ignore thì
# `git status --short` ở bước 1 của lần phát hành sau không bao giờ trống.
.rollback-images
.rollback-dump
.last-deployed-sha
.pending-migrations

# Kết quả dọn demo ở gốc repo trên máy chủ (runbook mục 5 bước 7c). Giữ lại trên máy chủ: `.demo-cleanup-apply.txt` chứa
# khối hoàn tác.
.demo-cleanup-*
