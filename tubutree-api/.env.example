# ========================================
# CẤU HÌNH ỨNG DỤNG TUBU TREE
# ========================================
# Copy file này thành .env rồi điền thông tin thật vào.
# Lệnh (Windows): copy .env.example .env
# Lệnh (Linux):   cp .env.example .env

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database PostgreSQL ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Production: dùng managed Postgres (Supabase / Neon / Railway PG addon)
DATABASE_URL="postgresql://tubutree:password123@localhost:5433/tubutree_db?schema=public"

# --- Redis (bộ nhớ đệm) ---
# Production: dùng Upstash hoặc Railway Redis addon
REDIS_URL="redis://localhost:6380"

# --- Zalo Mini App ---
# Lấy tại: https://developers.zalo.me
ZALO_APP_ID=
ZALO_APP_SECRET=

# --- Pancake POS ---
# Lấy tại: Pancake Dashboard → Settings → API
PANCAKE_SHOP_ID=
PANCAKE_API_KEY=
# Warehouse mặc định: GET /api/v1/shops/:shop_id/warehouses?api_key=... rồi pick id
# Bắt buộc — Pancake reject order không có warehouse_id
PANCAKE_WAREHOUSE_ID=

# --- VietQR (thanh toán chuyển khoản) ---
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact

# --- Bảo mật ---
# JWT secret — TỐI THIỂU 16 ký tự. Generate: openssl rand -base64 48
# Nếu để trống / quá ngắn → server REFUSE TO START (fail-closed).
JWT_SECRET=

# --- Admin ---
# Danh sách Zalo UID admin, phân cách dấu phẩy.
# Lấy zalo_uid của user mình sau lần login đầu, rồi điền vào đây.
ADMIN_ZALO_UIDS=

# --- Webhook ---
# Shared secret Pancake POS phải gửi qua header X-Webhook-Secret mỗi request.
# Generate: openssl rand -base64 32
# Phải cấu hình bên Pancake Dashboard → Webhook header
WEBHOOK_SECRET=

# --- Upload ---
# Thư mục lưu ảnh KYC (CCCD, selfie, GPKD). Tự tạo nếu chưa có.
# Production: mount volume bền (Railway/Render persistent disk hoặc S3 — defer)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
