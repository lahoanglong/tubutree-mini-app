# ========================================
# CẤU HÌNH ỨNG DỤNG TUBU TREE
# ========================================
# Copy file này thành .env rồi điền thông tin thật vào.
# Lệnh: copy .env.example .env

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database PostgreSQL ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://tubutree:password123@localhost:5432/tubutree_db?schema=public"

# --- Redis (bộ nhớ đệm) ---
REDIS_URL="redis://localhost:6379"

# --- Zalo Mini App ---
# Lấy tại: https://developers.zalo.me
ZALO_APP_ID=
ZALO_APP_SECRET=

# --- Pancake POS ---
# Lấy tại: Pancake Dashboard → Settings → API
PANCAKE_SHOP_ID=
PANCAKE_API_KEY=

# --- VietQR (thanh toán chuyển khoản) ---
# Thông tin tài khoản ngân hàng để tạo mã QR
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact

# --- Bảo mật ---
# JWT secret key - đổi thành chuỗi ngẫu nhiên phức tạp khi lên production!
JWT_SECRET=super_secret_jwt_key_here
