# ──────────────────────────────────────────────────────────────
# Tubu Tree — Production env. Copy thành `.env` cạnh docker-compose.prod.yml:
#     cp .env.production.example .env   &&   nano .env
# KHÔNG commit file .env (đã gitignore).
# ──────────────────────────────────────────────────────────────

# Root domain (KHÔNG kèm https://, KHÔNG kèm subdomain)
# Web → app.tubutree.com  |  API → api.tubutree.com
WEB_DOMAIN=tubutree.com
CORS_ORIGINS=https://tubutree.com,https://app.tubutree.com

# ── Postgres (chạy trong compose) ──
POSTGRES_USER=tubu
# ĐẶT chuỗi mạnh: openssl rand -hex 24. Mật khẩu đi nguyên văn vào DATABASE_URL (compose không mã hoá %), nên PHẢI an toàn cho URL:
# KHÔNG dùng base64 (có / và +), KHÔNG dùng ký tự / @ : # ? % hay dấu cách. Sai thì API báo "Invalid url" hoặc Prisma P1013 và không khởi động.
POSTGRES_PASSWORD=
POSTGRES_DB=tubutree
# DATABASE_URL / REDIS_URL do compose tự set trỏ về service nội bộ — KHÔNG cần điền.

# ── Trần CPU container api và web (CHỈ docker-compose.vietnix.yml, VPS dùng chung; xem phần đầu file đó) ──
# Mặc định <= 1 lõi vì Docker từ chối khởi động khi cpus lớn hơn số vCPU. VPS của Tubu Tree có từ 8 vCPU: đặt API_CPUS=2
# (chạy `nproc` để chắc máy thật có đủ lõi trước khi bỏ dấu #).
# API_CPUS=2
# WEB_CPUS=1

# ── JWT (tự sinh, mỗi cái 1 chuỗi khác nhau) ──
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Giây token vừa xoay còn dùng lại được (nhiều tab refresh cùng lúc); 0 = tắt
JWT_REFRESH_REUSE_GRACE_SECONDS=30

# Cookie đăng nhập của web (tuỳ chọn). Để dạng chú thích: compose đưa `KHOÁ=` rỗng vào API, và AUTH_COOKIE_SAMESITE rỗng làm API không khởi động.
# SAMESITE mặc định lax; đặt none chỉ khi web và API khác site. DOMAIN để trống nếu cùng host; muốn dùng chung phiên giữa các subdomain thì `.tubutree.com`.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# ── Throttle: token nội bộ để SSR của web được miễn giới hạn tốc độ (api + web dùng chung) ──
# Sinh: openssl rand -hex 32. Rỗng = tắt đường miễn (SSR có thể bị 429 khi đông).
THROTTLE_BYPASS_TOKEN=

# ── Zalo Mini App / OA ──
ZALO_APP_ID=2070857098114207963
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=
# Token làm mới của OA: chỉ để khởi tạo, sau đó API tự xoay và lưu DB. Thiếu thì khoảng 25 giờ sau token truy cập hết hạn và ZNS ngừng gửi.
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_ID=
# Token tĩnh xác thực webhook CSKH của OA (dán vào Zalo OA, mục webhook). Để trống thì production từ chối MỌI request webhook (401).
ZALO_OA_WEBHOOK_SECRET=
# Cầu nối Zalo cá nhân cho chat CSKH (service zalo-bridge). Để trống thì chat không chuyển được tin vào nhóm Zalo.
ZALO_BRIDGE_URL=
ZALO_BRIDGE_SECRET=

# ── Cloudinary (ảnh đánh giá, minh chứng: web nhúng lúc build qua NEXT_PUBLIC_CLOUDINARY_*; unsigned preset) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Pancake POS (nguồn chân lý catalog/đơn) ──
PANCAKE_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_API_KEY=
PANCAKE_SHOP_ID=
# Token webhook — dán y hệt vào Pancake → Request Headers: x-webhook-token
PANCAKE_WEBHOOK_SECRET=   # rotate trên Pancake và set ở .env, KHÔNG commit value

# ── Báo động sức khoẻ vận hành (ngoài thông báo in-app cho admin; bỏ trống = chỉ in-app). Slack/Google Chat/n8n, định dạng: docs/GO-LIVE-KEYS.md mục 8 ──
OPS_ALERT_WEBHOOK_URL=
# Email báo động (kênh thứ hai, gửi đúng các lần webhook trên gửi; bỏ trống CẢ BẢY biến = tắt). Đã đặt một biến thì phải
# đủ OPS_ALERT_EMAIL_TO + SMTP_HOST + (SMTP_FROM hoặc SMTP_USER là địa chỉ email), SMTP_USER và SMTP_PASS đi cặp — dở dang
# thì API không khởi động. Mật khẩu KHÔNG commit; nên là mật khẩu ứng dụng, không chứa $ hoặc dấu nháy. Chi tiết: docs/GO-LIVE-KEYS.md mục 8.
# Người nhận cách nhau bằng dấu phẩy hoặc chấm phẩy. SMTP_PORT rỗng = 587 (465 khi SMTP_SECURE=true); SMTP_SECURE=true là TLS ngay từ đầu.
OPS_ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# alerts@tubutree.com hoặc Tubu Tree <alerts@tubutree.com>
SMTP_FROM=
# Nhãn môi trường ở đầu tiêu đề email, vd "staging" → "[Tubu Tree · staging] ...". Rỗng = NODE_ENV.
OPS_ALERT_ENV_LABEL=

# ── Gomdon (thu gom vật liệu tái chế — đơn đổi hàng BestExpress; bỏ trống = tắt) ──
# Trống ở production = https://admin.gomdon.com.vn
GOMDON_BASE_URL=
GOMDON_PHONE=
# Mật khẩu KHÔNG commit; không nhập vào tab Cấu hình admin (lộ ở GET /admin/config + lịch sử).
# Comment để dòng riêng: docker env_file KHÔNG hiểu comment cuối dòng.
GOMDON_PASSWORD=
# Bắt buộc nếu bật tính năng: đã đặt GOMDON_PHONE/PASSWORD mà thiếu secret thì API KHÔNG boot
# (và nếu trống, mọi webhook Gomdon bị 401). Webhook do quản trị Gomdon cấu hình (tài liệu không nói có
# cho đặt header): header x-webhook-token: <secret> nếu Gomdon cho, không thì
# URL https://<api>/api/webhooks/gomdon/<secret>. Xem docs/integrations/gomdon.md.
GOMDON_WEBHOOK_SECRET=
# Bật lựa chọn ở checkout: SystemConfig shipping.gomdon.recycling_enabled = true (mặc định false)

# ── ZaloPay (thanh toán online; bỏ trống = chỉ COD/Ví) ──
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
# Sandbox: https://sb-openapi.zalopay.vn/v2  · Production: https://openapi.zalopay.vn/v2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2

# ── ZNS ──
ZNS_BASE_URL=https://business.openapi.zalo.me

# ── Accesstrade (cashback) ──
ACCESSTRADE_BASE_URL=https://api.accesstrade.vn/v1
ACCESSTRADE_TOKEN=
ACCESSTRADE_PUBLISHER_ID=
ACCESSTRADE_WEBHOOK_SECRET=
