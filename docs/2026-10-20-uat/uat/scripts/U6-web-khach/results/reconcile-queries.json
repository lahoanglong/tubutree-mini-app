  {
    "title": "Đơn có tổng dòng hàng ≠ tạm tính",
    "query": "SELECT o.code, o.subtotal::int, SUM(oi.total)::int AS items_sum FROM orders o JOIN order_items oi ON oi.\"orderId\" = o.id WHERE o.\"userId\" = ANY($1) GROUP BY o.id HAVING SUM(oi.total) <> o.subtotal",
    "params": [
