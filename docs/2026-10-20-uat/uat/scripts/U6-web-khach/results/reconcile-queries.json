  {
    "title": "Số dư điểm = tổng sổ điểm (lô STANDARD)",
    "query": "SELECT u.id, u.\"pointsBalance\"::int AS balance, COALESCE(SUM(p.delta) FILTER (WHERE p.lot = 'STANDARD'), 0)::int AS ledger_sum, COUNT(p.id)::int AS rows FROM users u LEFT JOIN points_transactions p ON p.\"userId\" = u.id WHERE u.id = ANY($1) GROUP BY u.id ORDER BY u.id",
    "params": [
