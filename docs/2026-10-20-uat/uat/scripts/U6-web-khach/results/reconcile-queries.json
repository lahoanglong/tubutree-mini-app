  {
    "title": "Đơn có tổng ≠ tạm tính − giảm + phí ship (bỏ đơn mẫu cũ)",
    "query": "SELECT code, status, subtotal::int, discount::int, \"shippingFee\"::int AS fee, total::int, (subtotal - discount + \"shippingFee\")::int AS expected FROM orders WHERE \"userId\" = ANY($1) AND total <> subtotal - discount + \"shippingFee\" ORDER BY \"createdAt\"",
    "params": [
      [
        "uat_returning",
        "uat_new",
        "uat_new_nophone"
      ]
    ],
    "rows": []
  },
  {
    "title": "Đơn có giảm ≠ mã + combo + hạng + Điểm Xanh",
    "query": "SELECT code, discount::int, (\"couponDiscount\" + \"comboDiscount\" + \"tierDiscount\" + \"pointsDiscount\")::int AS parts FROM orders WHERE \"userId\" = ANY($1) AND discount <> \"couponDiscount\" + \"comboDiscount\" + \"tierDiscount\" + \"pointsDiscount\"",
    "params": [
      [
        "uat_returning",
        "uat_new",
        "uat_new_nophone"
      ]
    ],
    "rows": []
  },
  {
    "title": "Đơn có tổng dòng hàng ≠ tạm tính",
    "query": "SELECT o.code, o.subtotal::int, SUM(oi.total)::int AS items_sum FROM orders o JOIN order_items oi ON oi.\"orderId\" = o.id WHERE o.\"userId\" = ANY($1) GROUP BY o.id HAVING SUM(oi.total) <> o.subtotal",
    "params": [
      [
        "uat_returning",
        "uat_new",
        "uat_new_nophone"
      ]
    ],
    "rows": []
  },
  {
    "title": "Điểm tích của đơn đã giao trong đợt UAT (từ 2026-10-19): so với công thức 2% × tiền hàng sau giảm × hệ số hạng. Bỏ các đơn mẫu có sẵn trong DB mẫu (tạo 2026-10-09), phát hành điểm lúc khách còn hạng khác",
    "query": "SELECT o.code, u.\"tierId\", o.subtotal::int, o.\"couponDiscount\"::int AS coupon, o.\"pointsDiscount\"::int AS pts_disc, o.\"pointsEarned\"::int AS earned, COALESCE((SELECT SUM(p.delta) FROM points_transactions p WHERE p.\"userId\" = o.\"userId\" AND p.reason LIKE 'ORDER_DELIVERED:' || o.code || '%'), 0)::int AS ledger, FLOOR((o.subtotal - o.\"couponDiscount\" - o.\"comboDiscount\" - o.\"tierDiscount\") * 0.02 * CASE u.\"tierId\" WHEN 'LOC_BIEC' THEN 1.2 WHEN 'DAI_THU' THEN 1.5 WHEN 'CO_THU' THEN 2 ELSE 1 END)::int AS expect_before_points, FLOOR((o.subtotal - o.\"couponDiscount\" - o.\"comboDiscount\" - o.\"tierDiscount\" - o.\"pointsDiscount\") * 0.02 * CASE u.\"tierId\" WHEN 'LOC_BIEC' THEN 1.2 WHEN 'DAI_THU' THEN 1.5 WHEN 'CO_THU' THEN 2 ELSE 1 END)::int AS expect_after_points FROM orders o JOIN users u ON u.id = o.\"userId\" WHERE o.\"userId\" = ANY($1) AND o.status = 'DELIVERED' AND o.\"createdAt\" >= '2026-10-19T00:00:00+07:00' ORDER BY o.\"createdAt\"",
    "params": [
      [
        "uat_returning",
        "uat_new",
        "uat_new_nophone"
      ]
    ],
