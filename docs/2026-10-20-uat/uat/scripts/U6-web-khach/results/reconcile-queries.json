  {
    "title": "Đơn có mã giảm giá còn hiệu lực phải có đúng 1 dòng coupon_redemptions; đơn huỷ không còn dòng",
    "query": "SELECT o.code, o.status, o.\"couponCode\", (SELECT count(*) FROM coupon_redemptions r WHERE r.\"orderId\" = o.id)::int AS redemptions FROM orders o WHERE o.\"userId\" = ANY($1) AND o.\"couponCode\" IS NOT NULL ORDER BY o.\"createdAt\"",
