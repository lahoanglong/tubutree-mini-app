  {
    "title": "Đơn trùng (cùng khách, cùng tổng, cách nhau dưới 1 giây): dấu hiệu bấm đặt hàng hai lần mà không được chặn",
    "query": "SELECT a.code AS a, b.code AS b FROM orders a JOIN orders b ON a.\"userId\" = b.\"userId\" AND a.id < b.id AND a.total = b.total AND ABS(EXTRACT(EPOCH FROM (a.\"createdAt\" - b.\"createdAt\"))) < 1 WHERE a.\"userId\" = ANY($1)",
    "params": [
