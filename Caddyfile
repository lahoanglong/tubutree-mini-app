# Caddy — reverse proxy + auto HTTPS (Let's Encrypt) cho Tubu Tree.
# WEB_DOMAIN = root domain (vd tubutree.com)
# Web chạy tại app.<domain>, API tại api.<domain>

# Web (Next.js)
app.{$WEB_DOMAIN} {
	encode gzip zstd
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:3000
}

# API (NestJS, global prefix /api)
# Webhook Pancake: https://api.{$WEB_DOMAIN}/api/webhooks/pancake
api.{$WEB_DOMAIN} {
	encode gzip zstd
	# Cổng nội bộ của cầu nối Zalo: cầu nối gọi api:3001 trong mạng Docker, từ ngoài không được chạm tới.
	@internal path_regexp (?i)^/api/internal(/|$)
	respond @internal 404
	reverse_proxy api:3001
}
