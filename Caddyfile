# Caddy — reverse proxy + auto HTTPS (Let's Encrypt) cho Tubu Tree.
# WEB_DOMAIN = root domain (vd tubutree.com)
# Web chạy tại app.<domain>, API tại api.<domain>

# Web (Next.js)
app.{$WEB_DOMAIN} {
	encode gzip zstd
	reverse_proxy web:3000
}

# API (NestJS, global prefix /api)
# Webhook Pancake: https://api.{$WEB_DOMAIN}/api/webhooks/pancake
api.{$WEB_DOMAIN} {
	encode gzip zstd
	reverse_proxy api:3001
}
