# PHASE 2 — dán ĐÈ lên phase1 sau khi `certbot certonly --webroot ... -d api.tubutree.com` chạy
# xong (đường dẫn cert cố định, không cần sửa gì thêm).
<VirtualHost *:80>
    ServerName api.tubutree.com
    ErrorLog "/www/wwwlogs/api.tubutree.com-error_log"
    CustomLog "/www/wwwlogs/api.tubutree.com-access_log" combined

    Alias /.well-known/acme-challenge/ /var/www/certbot/.well-known/acme-challenge/
    <Directory "/var/www/certbot/.well-known/acme-challenge/">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    ProxyPass /.well-known/acme-challenge/ !
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName api.tubutree.com
    ErrorLog "/www/wwwlogs/api.tubutree.com-error_log"
    CustomLog "/www/wwwlogs/api.tubutree.com-access_log" combined

    SSLEngine On
    SSLCertificateFile /etc/letsencrypt/live/api.tubutree.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/api.tubutree.com/privkey.pem

    # IP thật của khách khi bật proxy Cloudflare (☁ cam). API đặt `trust proxy` = 1 nên lấy hop CUỐI
    # của X-Forwarded-For, tức IP mà Apache thấy. Qua Cloudflare đó là IP edge, cả nghìn khách chung
    # một suất throttle đăng nhập/refresh (30/phút/IP) → 429 hàng loạt. mod_remoteip thay IP kết nối
    # bằng CF-Connecting-IP, CHỈ khi kết nối đến từ dải IP Cloudflare (nguồn khác không giả được).
    # Để ☁ xám (DNS only) thì khối này không đổi gì. Dải IP lấy từ https://www.cloudflare.com/ips/
    # (2026-10) — cập nhật khi Cloudflare đổi.
    <IfModule mod_remoteip.c>
        RemoteIPHeader CF-Connecting-IP
        RemoteIPTrustedProxy 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22
        RemoteIPTrustedProxy 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20
        RemoteIPTrustedProxy 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13
        RemoteIPTrustedProxy 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        RemoteIPTrustedProxy 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32
        RemoteIPTrustedProxy 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    </IfModule>

    ProxyPreserveHost On
    ProxyRequests Off
    RequestHeader set X-Forwarded-Proto "https"

    # Nén phản hồi (JSON, HTML, JS, CSS, SVG). API Nest không tự nén; Next đã tự nén nên mod_deflate
    # bỏ qua phản hồi đã có Content-Encoding. Thiếu mod_deflate hoặc mod_filter thì khối này bị bỏ qua, không gây lỗi: kiểm bằng
    # `bash ops/check-edge.sh` (dòng "nén"). Bật ☁ cam của Cloudflare thì Cloudflare tự nén ở biên, khối này vẫn vô hại.
    # AddOutputFilterByType thuộc mod_filter, bộ lọc DEFLATE thuộc mod_deflate: thiếu mod_filter mà vẫn có chỉ thị này là
    # lỗi cú pháp, làm configtest (và mọi lần graceful của Apache dùng chung với ChoDeli/WordPress) hỏng, nên bọc cả hai.
    <IfModule mod_deflate.c>
        <IfModule mod_filter.c>
            AddOutputFilterByType DEFLATE application/json application/manifest+json application/javascript text/javascript
            AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml image/svg+xml
        </IfModule>
    </IfModule>

    # Apache tái dùng kết nối rảnh tới Node. `ttl=30` bỏ kết nối rảnh quá 30 giây, ngắn hơn keepAliveTimeout 125 giây của API
    # (apps/api/src/config/http-timeouts.ts), nên Apache không gặp kết nối Node vừa đóng (502 lẻ "error reading status line", A3-010).
    # Dự phòng nếu vẫn thấy 502 lẻ trong error_log: thêm `disablereuse=On` sau `ttl=30` (mỗi request một kết nối mới).
    ProxyPass / http://127.0.0.1:14001/ ttl=30
    ProxyPassReverse / http://127.0.0.1:14001/
</VirtualHost>
