# CUTOVER — vhost cho tubutree.com (apex) và www.tubutree.com trên Apache aaPanel của VPS Vietnix. CHƯA dùng: chỉ cài khi chủ đã duyệt cutover.
#
# Cài bằng MỘT lệnh (kiểm trước, rồi cài; tự quay lại nếu configtest hoặc kiểm chuyển hướng hỏng), chạy TRÊN VPS:
#   # Phương án 1 (DNS-01 trước khi đổi DNS, cần Cloudflare API token ở /root/.secrets/cloudflare.ini):
#   bash ops/setup-apex-dns01-ssl.sh --issue
#   bash ops/cutover-apex-apply.sh --apply    # cài vhost này thành tubutree.com.conf, configtest, graceful, kiểm 459 URL WordPress + ảnh uploads
#
#   # Phương án 2 (HTTP-01 webroot không cần Cloudflare API token, chạy ngay sau khi trỏ A record tubutree.com + www về 14.225.207.177):
#   bash ops/cutover-apex-http01.sh --apply   # cài phase1 (:80), xin cert webroot, rồi tự chạy cutover-apex-apply.sh --apply
#
#   # Gỡ vhost quay lại trạng thái trước khi cài:
#   bash ops/cutover-apex-rollback.sh
#
# Điều kiện (cutover-apex-apply.sh kiểm hết, thiếu cái nào thì dừng trước khi đụng Apache):
#   1. Chứng chỉ phủ cả hai tên (tubutree.com + www.tubutree.com), đặt ở /etc/letsencrypt/live/tubutree.com/ (cấp qua setup-apex-dns01-ssl.sh hoặc cutover-apex-http01.sh).
#   2. Web chạy bản dựng có NEXT_PUBLIC_SITE_URL=https://tubutree.com (biến build, nhúng vào bundle). Đặt trong .env rồi build lại ảnh web bằng docker-compose.vietnix.yml.
#   3. API chấp nhận Origin https://tubutree.com và https://www.tubutree.com cho đăng nhập: CORS_ORIGINS=https://app.tubutree.com,https://tubutree.com,https://www.tubutree.com.
#   4. Ảnh WordPress đã sao về /www/wwwroot/tubutree.com/wp-content/uploads (khối "ẢNH WORDPRESS" bên dưới phục vụ thẳng từ đây, giữ 200 OK vĩnh viễn).
#   5. Đăng ký https://tubutree.com/dang-nhap/callback ở Zalo Developers (GIỮ URI của app.tubutree.com).
#   6. WordPress cũ ở ZenCloud (42.1.122.84) chuyển về domain https://blog.tubutree.com (chạy finalize-blog-cutover.sh trên ZenCloud).
#
# Apache dùng chung với ChoDeli (đang bán thật): `apachectl -t` rồi `apachectl -k graceful`, TUYỆT ĐỐI không `restart`; file lỗi để nguyên trên đĩa làm hỏng lần reload
# kế tiếp của aaPanel (script apply tự gỡ file nếu configtest hỏng).

<VirtualHost *:80>
    ServerName tubutree.com
    ServerAlias www.tubutree.com
    ErrorLog "/www/wwwlogs/tubutree.com-error_log"
    CustomLog "/www/wwwlogs/tubutree.com-access_log" combined

    # Giữ đường HTTP-01 Let's Encrypt mở ở cổng 80 để certbot.timer tự gia hạn chứng chỉ mỗi 60-90 ngày khi dùng phương án webroot.
    Alias /.well-known/acme-challenge/ /var/www/certbot/.well-known/acme-challenge/
    <Directory "/var/www/certbot/.well-known/acme-challenge/">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    ProxyPass /.well-known/acme-challenge/ !
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://tubutree.com$1 [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName www.tubutree.com
    ErrorLog "/www/wwwlogs/www.tubutree.com-error_log"
    CustomLog "/www/wwwlogs/www.tubutree.com-access_log" combined

    SSLEngine On
    SSLCertificateFile /etc/letsencrypt/live/tubutree.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/tubutree.com/privkey.pem

    # www về apex, giữ đường dẫn; Apache tự nối query gốc vào đích khi đích không có query.
    RewriteEngine On
    RewriteRule ^(.*)$ https://tubutree.com$1 [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName tubutree.com
    ErrorLog "/www/wwwlogs/tubutree.com-error_log"
    CustomLog "/www/wwwlogs/tubutree.com-access_log" combined

    SSLEngine On
    SSLCertificateFile /etc/letsencrypt/live/tubutree.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/tubutree.com/privkey.pem

    ProxyPreserveHost On
    ProxyRequests Off
    RequestHeader set X-Forwarded-Proto "https"

    # Giữ nguyên như vhost app: không includeSubDomains, không preload để còn đường quay lại.
    <IfModule mod_headers.c>
        Header always set Strict-Transport-Security "max-age=31536000"
    </IfModule>

    <IfModule mod_deflate.c>
        <IfModule mod_filter.c>
            AddOutputFilterByType DEFLATE application/json application/manifest+json application/javascript text/javascript
            AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml image/svg+xml
        </IfModule>
    </IfModule>

    # ── ẢNH WORDPRESS: /wp-content/uploads/ phục vụ THẲNG từ đĩa, tệp tĩnh chỉ đọc (200 OK vĩnh viễn) ────────────────────────────────────
    # Vì sao: link ảnh cũ nằm ở Google Images, xem trước Zalo/Facebook, bài blog, và cột ảnh sản phẩm do wp-image-sync đọc (https://tubutree.com/wp-content/uploads/...).
    # Phục vụ từ đĩa nghĩa là các link đó luôn trả 200 OK, không chuyển hướng và không đi qua Next hay origin nào.
    # `ProxyPass ... !` PHẢI đứng trước `ProxyPass /` bên dưới (Apache lấy luật khớp đầu tiên theo thứ tự khai báo).
    ProxyPass /wp-content/uploads/ !
    Alias /wp-content/uploads/ /www/wwwroot/tubutree.com/wp-content/uploads/
    <Directory "/www/wwwroot/tubutree.com/wp-content/uploads/">
        Options -Indexes -ExecCGI -Includes +SymLinksIfOwnerMatch
        AllowOverride None
        Require all granted
        # Tắt thực thi: tệp script trong uploads không bao giờ chạy và không được tải về như mã nguồn.
        RemoveHandler .php .phtml .phar .pl .py .cgi
        <FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|shtml)$">
            Require all denied
        </FilesMatch>
        <IfModule mod_headers.c>
            Header always set X-Content-Type-Options "nosniff"
            Header always set Cache-Control "public, max-age=2592000"
        </IfModule>
    </Directory>
    # ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

    # ── BLOG WORDPRESS: chuyển hướng vĩnh viễn 301 sang https://blog.tubutree.com/<đường dẫn> ────────────────────────────────────────
    # WordPress cũ chuyển về domain độc lập blog.tubutree.com. Toàn bộ bài viết /YYYY/MM/DD/<slug>/, /blog/*, /category/*, /tag/*, /author/*,
    # /feed/*, /comments/feed/*, /wp-json/* và tài nguyên giao diện /wp-content/(trừ uploads)/*, /wp-includes/* chuyển 301 thẳng 1 chặng
    # sang https://blog.tubutree.com/... (cùng quy ước với apps/web/src/lib/legacy-wp-redirects.ts). Không phụ thuộc mạng nội bộ tới ZenCloud.
    # Sitemap Rank Math (/sitemap_index.xml, /post-sitemap1.xml...) cố ý KHÔNG nằm ở đây để middleware Next chuyển 301 về /sitemap.xml của web mới.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/wp-content/uploads(?:/|$)
    RewriteRule ^/([0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+(?:/.*[^/])?)/*$ https://blog.tubutree.com/$1/ [R=301,L]
    RewriteRule ^/((?:blog|feed|comments/feed)(?:/.*[^/])?)/*$ https://blog.tubutree.com/$1/ [R=301,L]
    RewriteRule ^/((?:category|tag|author)/(?:.*[^/]))/*$ https://blog.tubutree.com/$1/ [R=301,L]
    RewriteRule ^/wp-json/*$ https://blog.tubutree.com/wp-json/ [R=301,L]
    RewriteRule ^/(wp-json/(?:.*[^/]))/*$ https://blog.tubutree.com/$1 [R=301,L]
    RewriteCond %{REQUEST_URI} !^/wp-content/uploads(?:/|$)
    RewriteRule ^/((?:wp-content|wp-includes)/.+)$ https://blog.tubutree.com/$1 [R=301,L]
    # ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────

    # Next standalone đóng kết nối rảnh sau KEEP_ALIVE_TIMEOUT=55000 ms; `ttl=30` bỏ kết nối rảnh trước mốc đó.
    ProxyPass / http://127.0.0.1:14000/ ttl=30
    ProxyPassReverse / http://127.0.0.1:14000/
</VirtualHost>

# ── SAU cutover: app.tubutree.com chuyển 301 sang apex, giữ đường dẫn và query (giữ ít nhất 12 tháng để không gãy QR in, link CTV, tin nhắn cũ) ──
# Sửa vhost app (ops/vietnix-vhost-app.conf.phase2): trong <VirtualHost *:443> của app.tubutree.com, thay hai dòng ProxyPass/ProxyPassReverse bằng:
#     RewriteEngine On
#     RewriteRule ^(.*)$ https://tubutree.com$1 [L,R=301]
# Làm bước này SAU khi apex chạy ổn và Search Console đã nhận trang mới, không làm cùng lúc với đổi DNS.
