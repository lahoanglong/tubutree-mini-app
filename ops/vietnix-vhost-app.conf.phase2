# PHASE 2 — dán ĐÈ lên phase1 sau khi certbot lấy cert cho app.tubutree.com xong.
<VirtualHost *:80>
    ServerName app.tubutree.com
    ErrorLog "/www/wwwlogs/app.tubutree.com-error_log"
    CustomLog "/www/wwwlogs/app.tubutree.com-access_log" combined

    Alias /.well-known/acme-challenge/ /var/www/certbot/.well-known/acme-challenge/
    <Directory "/var/www/certbot/.well-known/acme-challenge/">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    ProxyPass /.well-known/acme-challenge/ !
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName app.tubutree.com
    ErrorLog "/www/wwwlogs/app.tubutree.com-error_log"
    CustomLog "/www/wwwlogs/app.tubutree.com-access_log" combined

    SSLEngine On
    SSLCertificateFile /etc/letsencrypt/live/app.tubutree.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/app.tubutree.com/privkey.pem

    ProxyPreserveHost On
    ProxyRequests Off
    RequestHeader set X-Forwarded-Proto "https"

    # HSTS cho web (next.config không gửi). Chỉ ở vhost 443; api đã có từ helmet. Cố ý KHÔNG includeSubDomains/preload:
    # includeSubDomains sẽ ép cả subdomain khác của tên miền gốc (chưa chắc có HTTPS) và preload thì không gỡ lại được.
    <IfModule mod_headers.c>
        Header always set Strict-Transport-Security "max-age=31536000"
    </IfModule>

    # Nén phản hồi (JSON, HTML, JS, CSS, SVG). Next đã tự nén phản hồi của nó nên mod_deflate
    # bỏ qua phản hồi đã có Content-Encoding. Thiếu mod_deflate hoặc mod_filter thì khối này bị bỏ qua, không gây lỗi: kiểm bằng
    # `bash ops/check-edge.sh` (dòng "nén"). Bật ☁ cam của Cloudflare thì Cloudflare tự nén ở biên, khối này vẫn vô hại.
    # AddOutputFilterByType thuộc mod_filter, bộ lọc DEFLATE thuộc mod_deflate: thiếu mod_filter mà vẫn có chỉ thị này là
    # lỗi cú pháp, làm configtest (và mọi lần graceful của Apache dùng chung với ChoDeli/WordPress) hỏng, nên bọc cả hai.
    <IfModule mod_deflate.c>
        <IfModule mod_filter.c>
            AddOutputFilterByType DEFLATE application/json application/manifest+json application/javascript text/javascript
            AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml image/svg+xml
        </IfModule>
    </IfModule>

    # Next standalone đóng kết nối rảnh sau KEEP_ALIVE_TIMEOUT=55000 ms (docker-compose.vietnix.yml); `ttl=30` bỏ kết nối rảnh
    # trước mốc đó. Dự phòng nếu vẫn thấy 502 lẻ: thêm `disablereuse=On` sau `ttl=30`.
    ProxyPass / http://127.0.0.1:14000/ ttl=30
    ProxyPassReverse / http://127.0.0.1:14000/
</VirtualHost>
