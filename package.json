{
  "name": "tubutree",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:vars": "node scripts/check-undefined-css-vars.mjs",
    "lint:parity": "node scripts/check-platform-parity.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test --filter=!@tubutree/e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @tubutree/api prisma:generate",
    "db:migrate": "pnpm --filter @tubutree/api prisma:migrate",
    "db:seed": "pnpm --filter @tubutree/api prisma:seed",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "packageExtensions": {
      "zmp-ui": {
        "peerDependencies": {
          "react": "^18.0.0",
          "react-dom": "^18.0.0",
          "@types/react": "^18.0.0"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "next": {
        "peerDependencies": {
          "@types/react": "^19.0.0"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@tanstack/react-query": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-router": {
        "peerDependencies": {
          "@types/react": "^18.0.0"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-router-dom": {
        "peerDependencies": {
          "@types/react": "^18.0.0"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  }
}
